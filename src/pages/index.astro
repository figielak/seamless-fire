<script>
  import { dataUrl, fetchJson, loadCountry, loadDaily, type Country, type CountryData } from '../lib/data';
  import { addDays, comparedDays, daysInMonth, mtdStats, sameDaysHistory, seriesEnd, type LiveInfo } from '../lib/live';
  import { factorWord, localWeather, seasonWeights, watchPlaces, type ForecastPoint } from '../lib/watch';
  import { seasonData, seasonYears } from '../lib/season';
  import { trends, type Trend } from '../lib/trend';
  import {
    annualTotals,
    coverageSpan,
    harmonize,
    harmonizeArea,
    monthAbs,
    monthCount,
    monthlyTotals,
    monthStr,
    rawRatio,
    rawSplice,
    type Harmonized,
  } from '../lib/harmonize';
  import {
    AreaError,
    PRESETS,
    bboxOverlap,
    keepFn,
    normalizeRect,
    parseHash,
    resolveShape,
    serializeHash,
    shapeBBox,
    type AreaSpec,
    type ViewState,
  } from '../lib/geo';
  import { monthStats, topAnomalies } from '../lib/stats';
  import { exportHotspots, hotspotFiles, monthlyCsv } from '../lib/csv';
  import {
    cellLayer, recurrenceLayer, yearRoundCells, type RecurrenceMeta, type RecurrenceMonth, type YearRoundCell,
  } from '../lib/cellmap';
  import type { Hotspot } from '../lib/map';
  import { mainSeason, monthProfile, monthsText, placeMonths, placesInArea, reportHtml, type Places } from '../lib/report';
  import { WORLD_CODE, mergeLayers, sumAnnual, sumSeries, unionBBox, worldModel } from '../lib/world';

  const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  const MONTHS_LONG = [
    'January', 'February', 'March', 'April', 'May', 'June',
    'July', 'August', 'September', 'October', 'November', 'December',
  ];
  // Fixed map colour scales (log), shared by all countries. A cell has at most 31 cell-days in
  // a month; per-cell 99th percentiles are 6–15 per month and 4–19 per year (2012–2025, 8 countries).
  const MAP_SCALE = {
    month: { max: 31, unit: 'cell-days per 0.1° cell' },
    period: { max: 30, unit: 'cell-days per 0.1° cell per year' },
    short: { max: 31, unit: 'cell-days per 0.1° cell, total in the period' },
    // Linear 0–100%: share of the years in which the ~1 km cell had ≥1 S-NPP detection that month.
    recur: (years: number, name: string, minYears = 2) => ({
      max: 100,
      linear: true,
      ticks: [25, 50, 75],
      unit: `% of ${name}s with fire in the 0.01° cell (~1 km, VIIRS S-NPP); fire in only ${minYears - 1} year not shown`,
      format: (v: number) => `${Math.round(v)}% (${Math.round((v * years) / 100)} of ${years} ${name}s)`,
    }),
  };
  // Calendar "vs typical" mode: log2 of the anomaly ratio, clipped to ¼…4×; white = typical.
  const ANOM_LOG2 = 2;
  const ANOM_SCALE: [number, string][] = [
    [0, '#2166ac'], [0.25, '#92c5de'], [0.5, '#f7f7f7'], [0.75, '#f4a582'], [1, '#b2182b'],
  ];
  let calMode: 'value' | 'anom' = 'value';
  const FIRMS_URL = 'https://firms.modaps.eosdis.nasa.gov/download/';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const select = $<HTMLSelectElement>('country');
  const status = $('status');
  const nowEl = $('now');
  const calEl = $('calendar');
  const noteEl = $('calendar-note');
  const annualEl = $('annual');
  const seasonEl = $('season');
  const forecastEl = $('forecast');
  const annualNote = $('annual-note');
  const anomEl = $('anomalies');
  const customEl = $('custom');
  const presetSel = $<HTMLSelectElement>('preset');
  const rectForm = $<HTMLFormElement>('rect');
  const areaNote = $('area-note');
  const fromM = $<HTMLSelectElement>('from-m');
  const fromY = $<HTMLSelectElement>('from-y');
  const toM = $<HTMLSelectElement>('to-m');
  const toY = $<HTMLSelectElement>('to-y');
  const dlMonthly = $<HTMLButtonElement>('dl-monthly');
  const dlHotspots = $<HTMLButtonElement>('dl-hotspots');
  const dlReport = $<HTMLButtonElement>('dl-report');
  const dlCancel = $<HTMLButtonElement>('dl-cancel');
  const dlStatus = $('dl-status');
  const dlNote = $('dl-note');
  const viewBtns = [...document.querySelectorAll<HTMLButtonElement>('.view-toggle button[data-view]')];
  const viewNote = $('view-note');
  const modeRadios = [...document.querySelectorAll<HTMLInputElement>('input[name=mode]')];

  let countries: Country[] = [];
  let requestId = 0;
  let state: ViewState = { code: 'PL', area: { kind: 'country' } };
  let lastCustom: AreaSpec | null = null; // restored when switching back to "Custom area"
  // h = series of the selected area (or the country); hc = country series (map layer shares).
  let current: {
    country: Country; d: CountryData; h: Harmonized; hc: Harmonized; fromIdx: number; toIdx: number;
    parts?: { d: CountryData; hc: Harmonized; h: Harmonized }[]; // "All countries": per-country results
  } | null = null;
  type MapMode = 'month' | 'period' | 'recur';
  let mapMode: MapMode = 'month';
  let recMonth = 3; // calendar month (0 = Jan) of the recurrence layer
  let selAbs: number | null = null; // month shown on the map (absolute month number)
  let exportJob: AbortController | null = null;
  let areaMap: import('../lib/map').AreaMap | null = null;
  let plotlyPromise: Promise<typeof import('plotly.js-dist-min')['default']> | null = null;

  function plotly() {
    plotlyPromise ??= import('plotly.js-dist-min').then((m) => m.default);
    return plotlyPromise;
  }

  const fmt = (v: number) =>
    v >= 100 ? Math.round(v).toLocaleString('en-US') : v >= 10 ? v.toFixed(0) : v.toFixed(1);
  const monthLabel = (ym: string) => {
    const [y, m] = ym.split('-').map(Number);
    return `${MONTHS_LONG[m - 1]} ${y}`;
  };
  const shortMonth = (ym: string) => {
    const [y, m] = ym.split('-').map(Number);
    return `${MONTHS[m - 1]} ${y}`;
  };

  function escapeHtml(s: string) {
    return s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  }

  function areaLabel(a: AreaSpec): string | null {
    if (a.kind === 'country') return null;
    if (a.kind === 'preset') return PRESETS.find((p) => p.id === a.id)?.name ?? a.id;
    return a.shape.kind === 'rect' ? 'custom rectangle' : 'custom polygon';
  }

  function areaSlug(a: AreaSpec): string {
    return a.kind === 'country' ? 'country' : a.kind === 'preset' ? a.id : a.shape.kind === 'rect' ? 'rectangle' : 'polygon';
  }

  // ------------------------------------------------------------------ "Now" panel

  /** Anomaly index figure and the history lines shared by full months and month to date. */
  function compareHtml(
    s: { ratio: number | null; median: number | null; p10: number | null; p90: number | null; percentile: number;
      nAll: number; refFrom: number; refTo: number },
    value: number,
    what: string, // "the usual October" / "1–13 November in earlier years"
    rankOf: string, // "26 Octobers" / "15 years (1–13 Nov)"
  ): string {
    if (s.ratio === null) return `<p class="note">Not enough history for a typical value.</p>`;
    const r = s.ratio;
    const word = r >= 1.25 ? 'above' : r <= 0.8 ? 'below' : 'close to';
    const cls = r >= 1.25 ? 'hi' : r <= 0.8 ? 'lo' : 'mid';
    const typical = `<div><dt>typical (median ${s.refFrom}–${s.refTo})</dt><dd>${fmt(s.median!)}</dd></div>`;
    if (value === 0) {
      // Nothing detected: a rank among zeros says nothing, state it plainly.
      return `
        <div class="now-fig mid"><b>No detections so far</b><span>${s.median === 0 ? 'usual for this time of year' : 'in this period'}</span></div>
        <dl>${typical}</dl>`;
    }
    return `
        <div class="now-fig ${cls}" title="Anomaly index = (value + k) / (median + k); 1 = typical. k is a small offset that keeps tiny counts from exploding, so this is not a plain ratio."><b>${r >= 10 ? r.toFixed(0) : r.toFixed(1)}</b>
          <span>anomaly index (1 = typical), ${word} ${what}</span></div>
        <dl>
          ${typical}
          <div><dt>usual range (middle 80% of years)</dt><dd>${fmt(s.p10!)} – ${fmt(s.p90!)}</dd></div>
          <div><dt>of ${rankOf} were lower</dt>
          <dd>${Math.round(s.percentile)}%</dd></div>
        </dl>`;
  }

  let nowToken = 0;

  /** Same days of the current (partial) month in earlier years, for the selected area; summed over
   * countries in "All countries". Daily files are cached in data.ts. */
  async function sameDaysTotals(d: CountryData, info: LiveInfo): Promise<{ hist: Map<number, number>; days: Set<number> }> {
    const shape = resolveShape(state.area);
    const keep = shape ? keepFn(shape) : undefined;
    const days = comparedDays(info);
    const parts = current?.parts ? current.parts.map((p) => p.d) : [d];
    const month = Number(info.lastMonth.slice(5, 7));
    const dailies = await Promise.all(parts.map((p) => loadDaily(p.code, month)));
    const hist = new Map<number, number>();
    dailies.forEach((dl, k) => {
      for (const [y, v] of sameDaysHistory(dl, days, parts[k].cells.cell_deg, keep)) hist.set(y, (hist.get(y) ?? 0) + v);
    });
    return { hist, days };
  }

  function renderNow(country: Country, d: CountryData, h: Harmonized) {
    const token = ++nowToken;
    const idx = h.value.length - 1;
    const label = areaLabel(state.area);
    const title = `<h2>Now · ${escapeHtml(country.name)}${label ? `, ${escapeHtml(label)}` : ''}</h2>`;
    const areaNote = h.area ? ' · custom area: higher uncertainty' : '';
    const info = d.model.live as LiveInfo | undefined;

    if (h.partial[idx] && info) {
      // Current month so far: compare with the same days of earlier VIIRS years.
      const ym = monthStr(monthAbs(h.firstMonth) + idx);
      const calName = MONTHS_LONG[Number(ym.slice(5, 7)) - 1];
      const span = `1–${info.throughDay} ${calName.slice(0, 3)}`;
      const prev = monthStats(h, idx - 1);
      const prevName = MONTHS_LONG[monthAbs(prev.month) % 12];
      const prevLine = prev.ratio === null ? '' :
        ` · last full month ${monthLabel(prev.month)}: ${fmt(prev.value)} cell-days,
          anomaly index ${prev.ratio >= 10 ? prev.ratio.toFixed(0) : prev.ratio.toFixed(1)} vs the usual ${prevName}`;
      const head = `
      <div class="now-head">
        ${title}
        <p class="now-month">${calName} ${ym.slice(0, 4)} so far (${span})<span class="flag">month to date</span><span class="flag">near real-time</span></p>
        <p class="now-note">Data through ${info.last} UTC · NOAA-20 on the S-NPP scale (${current?.parts ? 'factor per country' : `× ${info.factor.toFixed(3)}`})${areaNote}${prevLine}</p>
      </div>
      <div class="now-fig"><b>${fmt(h.value[idx])}</b><span>fire cell-days, ${span}</span></div>`;
      nowEl.innerHTML = head + `<p class="note now-wait">Comparing with ${span} in earlier years…</p>`;
      nowEl.hidden = false;
      void (async () => {
        try {
          const { hist, days } = await sameDaysTotals(d, info);
          if (token !== nowToken) return;
          const st = mtdStats(h.value[idx], hist, info, d.model, days.size, monthStats(h, idx).k);
          const gapNote = days.size < info.throughDay
            ? `<p class="note">${info.throughDay - days.size} day(s) without data are left out of both sides.</p>` : '';
          nowEl.innerHTML = head + compareHtml(st, h.value[idx], `${span} in earlier years`, `${st.nAll} years (${span}, ${st.firstYear}–${ym.slice(0, 4)})`) + gapNote;
        } catch (err) {
          console.error(err);
          if (token === nowToken) nowEl.innerHTML = head + `<p class="note">The comparison with earlier years could not be loaded.</p>`;
        }
      })();
      return;
    }

    const s = monthStats(h, idx);
    const calName = MONTHS_LONG[(monthAbs(s.month) % 12)];
    const interval = h.estimated[idx]
      ? `, estimated (~80%: ${fmt(h.lo[idx])} – ${fmt(h.hi[idx])})`
      : '';
    const flags = [
      h.preliminary[idx] ? 'preliminary (near real-time)' : '',
      h.lowQuality[idx] ? 'known sensor problem' : '',
    ].filter(Boolean);
    nowEl.innerHTML = `
      <div class="now-head">
        ${title}
        <p class="now-month">${monthLabel(s.month)}${flags.map((f) => `<span class="flag">${f}</span>`).join('')}</p>
        <p class="now-note">Latest complete month · VIIRS S-NPP scale · model
          ${escapeHtml(d.model.model)}${areaNote}</p>
      </div>
      <div class="now-fig"><b>${fmt(s.value)}</b><span>fire cell-days${interval}</span></div>
      ${compareHtml(s, s.value, `the usual ${calName}`, `${s.nAll} ${calName}s`)}`;
    nowEl.hidden = false;
  }

  // ------------------------------------------------------------------ calendar

  async function renderCalendar(country: Country, d: CountryData, h: Harmonized, fromIdx: number, toIdx: number) {
    const Plotly = await plotly();
    const first = monthAbs(h.firstMonth);
    const y0 = Math.floor((first + fromIdx) / 12);
    const y1 = Math.floor((first + toIdx) / 12);
    const years: number[] = [];
    for (let y = y0; y <= y1; y++) years.push(y);

    const anom = calMode === 'anom';
    // "vs typical" always compares harmonized values (raw counts jump in 2012).
    const hh = current?.h ?? h;
    const z: (number | null)[][] = years.map(() => new Array(12).fill(null));
    const text: string[][] = years.map(() => new Array(12).fill(''));
    const lowX: number[] = [], lowY: number[] = [];
    const preX: number[] = [], preY: number[] = [];
    const partX: number[] = [], partY: number[] = [];
    const liveInfo = d.model.live as LiveInfo | undefined;
    const lastComplete = monthAbs(d.model.last_complete_month);
    // Months outside a sensor's raw-file coverage show "no data", not 0.
    const [modisFrom, modisTo] = coverageSpan(d.model, ['Terra', 'Aqua']) ?? [-Infinity, Infinity];
    const [viirsFrom, viirsTo] = coverageSpan(d.model, ['SNPP']) ?? [-Infinity, Infinity];
    const raw = (v: number, a: number, from: number, to: number) => (a < from || a > to ? 'no data' : fmt(v));
    const rawV = (v: number, a: number) => (a > lastComplete ? fmt(v) : raw(v, a, viirsFrom, viirsTo));
    let max = 0;
    for (let i = fromIdx; i <= toIdx; i++) {
      const a = first + i;
      const r = Math.floor(a / 12) - y0;
      const c = a % 12;
      const v = h.value[i];
      max = Math.max(max, v);
      const part = h.partial[i];
      const st = monthStats(hh, i);
      if (part) st.ratio = null; // month to date: compared in the "Now" panel, same days only
      z[r][c] = anom
        ? (st.ratio === null ? null : Math.max(-ANOM_LOG2, Math.min(ANOM_LOG2, Math.log2(st.ratio))))
        : Math.log10(1 + v);
      const lines = [
        `<b>${MONTHS[c]} ${years[r]}</b>`,
        h.raw
          ? `${a < monthAbs(d.model.viirs_first_month) ? 'Raw MODIS' : 'Raw VIIRS'}: <b>${fmt(v)}</b> cell-days`
          : h.estimated[i]
            ? `<b>${fmt(v)}</b> cell-days, likely ${fmt(h.lo[i])} – ${fmt(h.hi[i])} (~80%)`
            : `<b>${fmt(v)}</b> cell-days`,
      ];
      if (!h.raw) {
        lines.push(`Source: ${h.estimated[i] ? '<b>estimated</b> from MODIS by the model'
          : a > lastComplete ? 'observed, NOAA-20' : 'observed, VIIRS S-NPP'}`);
        lines.push(`Status: ${part ? 'month to date, preliminary' : h.preliminary[i] ? '<b>preliminary</b> (near real-time, may change)'
          : h.lowQuality[i] ? '<b>known sensor problem</b>' : 'final archive data'}`);
      }
      if (part && liveInfo) {
        lines.push(`So far: 1–${liveInfo.throughDay} ${MONTHS[c]} (month to date)`, 'Comparison with earlier years: see "Now"');
        partX.push(c); partY.push(years[r]);
      }
      if (a > lastComplete && !h.raw) {
        lines.push(`NOAA-20 near real-time, ${current?.parts ? 'factor per country' : `× ${d.model.n20_factor.toFixed(3)}`} (S-NPP scale)`);
      }
      if (st.ratio !== null) {
        const rt = st.ratio >= 10 ? st.ratio.toFixed(0) : st.ratio.toFixed(1);
        lines.push(`Typical: ${fmt(st.median!)} (median ${st.refFrom}–${st.refTo}) · anomaly index <b>${rt}</b>`);
      } else if (anom) lines.push('Not enough earlier years for a typical value');
      lines.push(
        `Raw MODIS: ${raw(h.modis[i], a, modisFrom, modisTo)}, raw VIIRS: ${rawV(h.viirs[i], a)}`,
      );
      if (h.viirsDet && !h.estimated[i]) lines.push(`${a > lastComplete ? 'NOAA-20' : 'VIIRS S-NPP'} detections${h.area ? ' in the area (cell centres inside)' : ''}: ${fmt(h.viirsDet[i])}`);
      if (h.terraOnly[i]) lines.push('Terra only (before Aqua), scaled up');
      if (h.lowQuality[i]) { if (h.raw) lines.push('Known sensor problem'); lowX.push(c); lowY.push(years[r]); }
      if (h.preliminary[i]) {
        if (h.raw) lines.push('Preliminary (near real-time)');
        if (!part) { preX.push(c); preY.push(years[r]); }
      }
      text[r][c] = lines.join('<br>');
    }

    // Colour range from the 2nd percentile up: large areas never get near 0, and a range starting
    // at 0 would paint every month in the same bright end of the scale.
    // Months with sensor problems (e.g. Terra-only 2000) are left out of the range.
    const shown: number[] = [];
    for (let i = fromIdx; i <= toIdx; i++) if (!h.lowQuality[i] && !h.partial[i]) shown.push(h.value[i]);
    shown.sort((p, q) => p - q);
    const low = shown[Math.floor(shown.length * 0.02)] ?? 0;
    const zmin = low >= 10 ? Math.log10(1 + low) : 0;
    const inRange = (t: number) => t <= Math.max(max, 1) * 1.05 && Math.log10(1 + t) >= zmin - 1e-9;
    let ticks = [0, 1, 3, 10, 30, 100, 300, 1000, 3000, 10000, 30000, 100000].filter(inRange);
    if (ticks.length < 4) ticks = [1, 2, 5].flatMap((m) => [1, 10, 100, 1000, 10000, 100000].map((p) => m * p))
      .sort((p, q) => p - q).filter(inRange);
    const data: Partial<Plotly.Data>[] = [
      {
        type: 'heatmap',
        x: MONTHS.map((_, i) => i),
        y: years,
        z,
        text: text as unknown as string[],
        hovertemplate: '%{text}<extra></extra>',
        hoverongaps: false,
        xgap: 1,
        ygap: 1,
        showlegend: false,
        ...(anom
          ? {
            colorscale: ANOM_SCALE,
            zmin: -ANOM_LOG2,
            zmax: ANOM_LOG2,
            colorbar: {
              title: { text: 'anomaly index', side: 'right' },
              tickvals: [-2, -1, 0, 1, 2],
              ticktext: ['¼ or less', '½', '1 (typical)', '2', '4 or more'],
              thickness: 12,
            },
          }
          : {
            colorscale: 'Cividis',
            zmin,
            zmax: Math.max(Math.log10(1 + Math.max(max, 1)), zmin + 0.1),
            colorbar: {
              title: { text: 'cell-days', side: 'right' },
              tickvals: ticks.map((t) => Math.log10(1 + t)),
              ticktext: ticks.map(String),
              thickness: 12,
            },
          }),
      } as Partial<Plotly.Data>,
      {
        type: 'scatter', mode: 'markers', x: lowX, y: lowY, name: 'known sensor problem',
        hoverinfo: 'skip',
        marker: { symbol: 'x-thin', size: 9, line: { width: 2, color: '#e8432e' } },
      },
      {
        type: 'scatter', mode: 'markers', x: preX, y: preY, name: 'preliminary',
        hoverinfo: 'skip',
        marker: { symbol: 'circle-open', size: 10, line: { width: 2, color: '#f28e2b' } },
      },
      {
        type: 'scatter', mode: 'markers', x: [], y: [], name: 'on the map', hoverinfo: 'skip',
        marker: { symbol: 'square-open', size: 16, line: { width: 2.5, color: '#e8432e' } },
      },
      {
        type: 'scatter', mode: 'markers', x: partX, y: partY, name: 'month to date', hoverinfo: 'skip',
        marker: { symbol: 'circle-open-dot', size: 11, line: { width: 2, color: '#f28e2b' }, color: '#f28e2b' },
      },
    ];

    // Step line between estimated and observed months (VIIRS starts in Feb 2012).
    const vf = monthAbs(d.model.viirs_first_month);
    const vy = Math.floor(vf / 12);
    const vc = vf % 12;
    const path = vc === 0
      ? `M -0.5 ${vy - 0.5} L 11.5 ${vy - 0.5}`
      : `M -0.5 ${vy + 0.5} L ${vc - 0.5} ${vy + 0.5} L ${vc - 0.5} ${vy - 0.5} L 11.5 ${vy - 0.5}`;
    const showStep = vf > first + fromIdx && vf <= first + toIdx;
    const lastEst = vf - 1;
    const estLabel = `${MONTHS[first % 12]} ${Math.floor(first / 12)} – ${MONTHS[lastEst % 12]} ${Math.floor(lastEst / 12)}`;

    // width 0 = calendar tab hidden while rendering; it is re-rendered when the tab is shown
    const narrow = calEl.clientWidth > 0 && calEl.clientWidth < 560;
    // Fit all years into the chart panel when it has room (rows 16–30 px), else let it scroll.
    // avail = room below the definition and toggle, minus the note under the calendar.
    const body = calEl.closest<HTMLElement>('.dock-body');
    const above = body ? calEl.getBoundingClientRect().top - body.getBoundingClientRect().top + body.scrollTop : 0;
    const avail = body && body.clientHeight > 300 ? body.clientHeight - above - 48 : 0;
    const rowH = avail ? Math.min(30, Math.max(11, Math.floor((avail - 100) / years.length))) : 20;
    const calH = Math.max(260, years.length * rowH + 100);
    calEl.style.height = `${calH}px`; // Plots.resize autosizes to the container
    const layout: Partial<Plotly.Layout> = {
      height: calH,
      margin: { l: 44, r: anom ? 30 : 10, t: 28, b: 40 },
      paper_bgcolor: 'rgba(0,0,0,0)',
      plot_bgcolor: 'rgba(0,0,0,0)',
      font: { family: 'system-ui, sans-serif', size: 12, color: '#24292f' },
      xaxis: {
        tickvals: MONTHS.map((_, i) => i),
        ticktext: narrow ? MONTHS.map((m) => m[0]) : MONTHS,
        side: 'top', range: [-0.5, 11.5], fixedrange: true, showgrid: false, zeroline: false,
      },
      yaxis: {
        range: [y1 + 0.5, y0 - 0.5], dtick: narrow && years.length > 12 ? 2 : 1, fixedrange: true, showgrid: false,
        zeroline: false,
      },
      shapes: showStep ? [{ type: 'path', path, line: { color: '#e8432e', width: 2.5 }, layer: 'above' }] : [],
      legend: { orientation: 'h', x: 0, y: -0.02, yanchor: 'top' },
      showlegend: true,
    };
    await Plotly.react(calEl, data as Plotly.Data[], layout, {
      responsive: true, displaylogo: false,
      modeBarButtonsToRemove: ['zoom2d', 'pan2d', 'select2d', 'lasso2d', 'zoomIn2d', 'zoomOut2d', 'autoScale2d', 'resetScale2d'],
      toImageButtonOptions: { filename: `seamless-fire-${country.code}-${areaSlug(state.area)}-calendar` },
    });
    markCalendar();
    const gd = calEl as unknown as {
      on: (ev: string, f: (e: { points?: { x: number; y: number }[] }) => void) => void; _sfClick?: boolean;
    };
    if (!gd._sfClick) {
      gd._sfClick = true;
      gd.on('plotly_click', (e) => {
        const pt = e.points?.[0];
        if (pt) selectMonth(Number(pt.y) * 12 + Number(pt.x));
      });
    }
    const parts = [];
    if (anom) {
      $('calendar-unit').textContent = 'month vs its typical level';
      const blank = z.flat().some((v) => v === null);
      noteEl.innerHTML = 'Anomaly index = (cell-days + k) / (typical + k), typical = median of the same month in the 10 years before, ' +
        'as in Top anomalies. Red: above the usual level, blue: below. Always harmonized values.' +
        (blank ? ' Blank: fewer than 5 earlier years to compare with.' : '');
      return;
    }
    if (h.raw) {
      parts.push(showStep
        ? 'Raw counts. Above the red line: MODIS, below: VIIRS S-NPP. The sensors count differently, so the series jumps at the switch.'
        : 'Raw counts of one sensor only.');
    } else if (vf > first + fromIdx) {
      parts.push(showStep
        ? `Above the red line (<b>${estLabel}</b>): estimated from MODIS. Below: observed VIIRS.`
        : 'All shown months are estimated from MODIS.');
    } else parts.push('All shown months are observed VIIRS.');
    parts.push(zmin > 0
      ? `Color scale is logarithmic; months below ${fmt(low)} share the darkest colour.`
      : 'Color scale is logarithmic.');
    if (h.area && !h.raw) parts.push('Before 2012 the area gets its share of the country estimate (area MODIS / country MODIS).');
    noteEl.innerHTML = parts.join(' ');
  }

  // ------------------------------------------------------------------ annual chart

  async function renderAnnual(country: Country, d: CountryData, h: Harmonized, fromIdx: number, toIdx: number) {
    const Plotly = await plotly();
    // "All countries": annual totals (and intervals) per country, then summed.
    const parts = current?.parts;
    const t = parts && !h.raw
      ? sumAnnual(parts.map((p) => ({ h: p.h, model: p.d.model })), fromIdx, toIdx)
      : annualTotals(h, d.model, fromIdx, toIdx);
    const hasInterval = t.map((x) => x.hi > x.lo);
    const vy = Math.floor(monthAbs(d.model.viirs_first_month) / 12);
    // Raw: grey = MODIS years, blue = VIIRS years (2012 is VIIRS except January).
    const colors = t.map((x) => ((h.raw ? x.year < vy : x.estimated) ? '#7f8fa6' : '#00224e'));
    const hover = t.map((x) => {
      const kind = h.raw ? (x.year < vy ? 'Raw MODIS' : 'Raw VIIRS') : x.estimated ? 'Estimated' : 'Observed';
      const lines = [`<b>${x.year}</b>`, `${kind}: <b>${fmt(x.value)}</b> cell-days`];
      if (x.hi > x.lo) lines.push(`~80% interval: ${fmt(x.lo)} – ${fmt(x.hi)}`);
      if (x.partial) lines.push(`Partial year: ${x.months} month${x.months === 1 ? '' : 's'}`);
      return lines.join('<br>');
    });
    const data: Partial<Plotly.Data>[] = [
      {
        type: 'bar',
        showlegend: false,
        x: t.map((x) => x.year),
        y: t.map((x) => x.value),
        text: hover,
        hovertemplate: '%{text}<extra></extra>',
        textposition: 'none',
        marker: {
          color: colors,
          pattern: { shape: t.map((x) => (x.partial ? '/' : '')), fgcolor: '#ffffff', size: 6 },
        },
        error_y: {
          type: 'data', symmetric: false,
          array: t.map((x, i) => (hasInterval[i] ? x.hi - x.value : 0)),
          arrayminus: t.map((x, i) => (hasInterval[i] ? x.value - x.lo : 0)),
          color: '#e8432e', thickness: 1.5, width: 3,
        },
      } as Partial<Plotly.Data>,
    ];
    // Trend lines (always on harmonized values: raw counts jump in 2012).
    const tr = trends(current?.h ?? h, d.model, fromIdx, toIdx);
    const line = (x: Trend | null, name: string, dash: string, color: string) => x ? [{
      type: 'scatter', mode: 'lines', name,
      x: [x.from, x.to], y: [x.from, x.to].map((yr) => Math.expm1(x.intercept + x.slope * yr)),
      line: { color, width: 2, dash }, hoverinfo: 'skip',
    } as Partial<Plotly.Data>] : [];
    if (!h.raw) {
      data.push(...line(tr.all, 'trend', 'dash', '#e8432e'), ...line(tr.viirs, 'trend, VIIRS only', 'dot', '#f28e2b'));
    }
    renderTrend(tr);
    const layout: Partial<Plotly.Layout> = {
      height: 320, // container height set in CSS: Plots.resize autosizes to it
      margin: { l: 60, r: 10, t: 30, b: 40 },
      paper_bgcolor: 'rgba(0,0,0,0)',
      plot_bgcolor: 'rgba(0,0,0,0)',
      font: { family: 'system-ui, sans-serif', size: 12, color: '#24292f' },
      xaxis: { fixedrange: true, dtick: t.length > 14 ? 2 : 1 },
      yaxis: { fixedrange: true, title: { text: 'cell-days' }, rangemode: 'tozero', gridcolor: '#e5e8ec' },
      bargap: 0.15,
      showlegend: true,
      legend: { orientation: 'h', x: 0, y: 1.02, yanchor: 'bottom' },
    };
    await Plotly.react(annualEl, data as Plotly.Data[], layout, {
      responsive: true, displaylogo: false,
      modeBarButtonsToRemove: ['zoom2d', 'pan2d', 'select2d', 'lasso2d', 'zoomIn2d', 'zoomOut2d', 'autoScale2d', 'resetScale2d'],
      toImageButtonOptions: { filename: `seamless-fire-${country.code}-${areaSlug(state.area)}-annual` },
    });
    const partial = t.filter((x) => x.partial).map((x) => x.year);
    annualNote.innerHTML =
      (h.raw
        ? 'Raw counts. Grey: MODIS, dark blue: VIIRS S-NPP (2012 includes raw MODIS for January). '
        : 'Grey: estimated from MODIS, dark blue: observed VIIRS (2012 mixes one estimated month). ') +
      (partial.length ? `Hatched: partial year (${partial.join(', ')}), not comparable with full years.` : '');
  }

  // ------------------------------------------------------------------ trends

  function trendText(t: Trend): string {
    const pct = (v: number) => `${v > 0 ? '+' : v < 0 ? '−' : ''}${Math.abs(v) >= 10 ? Math.abs(v).toFixed(0) : Math.abs(v).toFixed(1)}%`;
    const pStr = t.p < 0.001 ? 'p < 0.001' : `p = ${t.p.toFixed(t.p < 0.01 ? 3 : 2)}`;
    return `<b>${pct(t.pctPerYear)} per year</b> (95%: ${pct(t.lo)} to ${pct(t.hi)}), ` +
      (t.significant ? `<b>significant</b> (${pStr})` : `not significant (${pStr})`);
  }

  function renderTrend(tr: ReturnType<typeof trends>) {
    const el = $('trend');
    if (!tr.all) {
      el.innerHTML = `<p class="note">Trend: needs at least 8 complete years in the selected period.</p>`;
      return;
    }
    const a = tr.all, v = tr.viirs;
    let verdict = '';
    if (v) {
      const same = Math.sign(a.slope) === Math.sign(v.slope);
      verdict = a.significant && v.significant && same
        ? 'Both periods agree, so the trend does not come from the harmonization of MODIS years.'
        : a.significant && !same
          ? 'The VIIRS years alone point the other way: read the long-term trend with care.'
          : a.significant && !v.significant
            ? 'The VIIRS years alone are too few or too noisy to confirm it.'
            : '';
    }
    const months = tr.byMonth.map((t, c) => {
      if (!t) return `<div title="not enough years">${MONTHS[c]}<b>–</b></div>`;
      const cls = t.significant ? (t.slope > 0 ? 'up' : 'down') : '';
      const arrow = t.significant ? (t.slope > 0 ? '▲' : '▼') : '·';
      const pct = `${t.pctPerYear > 0 ? '+' : t.pctPerYear < 0 ? '−' : ''}${Math.abs(t.pctPerYear).toFixed(Math.abs(t.pctPerYear) >= 10 ? 0 : 1)}%`;
      return `<div class="${cls}" title="${MONTHS_LONG[c]} ${t.from}–${t.to}: ${pct} per year, p = ${t.p.toFixed(3)}">${MONTHS[c]}<b>${arrow} ${pct}</b></div>`;
    }).join('');
    el.innerHTML = `
      <p>Trend ${a.from}–${a.to}: ${trendText(a)}.</p>
      ${v ? `<p>VIIRS only ${v.from}–${v.to}: ${trendText(v)}. ${verdict}</p>` : ''}
      <p class="note">By calendar month (per year, ${a.from}–${a.to}; colour = significant, red up, blue down):</p>
      <div class="trend-months">${months}</div>`;
  }

  // ------------------------------------------------------------------ this season

  let seasonToken = 0;

  async function renderSeason() {
    if (!current || !seasonEl.offsetParent) return; // hidden tab: rendered when shown
    const token = ++seasonToken;
    const { d, h, country } = current;
    const info = d.model.live as LiveInfo | undefined;
    const idx = h.value.length - 1;
    let partial: { day: number; hist: Map<number, number> } | null = null;
    try {
      if (h.partial[idx] && info) partial = { day: info.throughDay, hist: (await sameDaysTotals(d, info)).hist };
    } catch (err) {
      console.error(err); // without the daily history the curve stops at the last full month
    }
    const Plotly = await plotly();
    if (token !== seasonToken || !current) return;
    const years = seasonYears(h, d.model.viirs_first_month);
    // Without the daily history a partial month cannot be compared: drop it from the chart.
    const hs = partial || !h.partial[idx] ? h : { ...h, value: h.value.slice(0, idx), partial: h.partial.slice(0, idx) };
    const sd = seasonData(hs, years, partial);
    const doyLabel = (x: number) => {
      const dt = new Date(Date.UTC(2025, 0, 1) + (x - 1) * 86_400_000);
      return x === 0 ? '1 Jan' : `${dt.getUTCDate()} ${MONTHS[dt.getUTCMonth()]}`;
    };
    const hover = (name: string, ys: number[]) => ys.map((v, k) => `<b>${name}</b>, by ${doyLabel(sd.x[k])}: ${fmt(v)} cell-days`);
    const data: Partial<Plotly.Data>[] = [
      ...sd.history.map((c) => ({
        type: 'scatter', mode: 'lines', x: sd.x, y: c.y, name: String(c.year), showlegend: false,
        line: { color: 'rgba(87,96,106,0.28)', width: 1 }, text: hover(String(c.year), c.y),
        hovertemplate: '%{text}<extra></extra>',
      }) as Partial<Plotly.Data>),
      { type: 'scatter', mode: 'lines', x: sd.x, y: sd.p10, line: { width: 0 }, hoverinfo: 'skip', showlegend: false },
      {
        type: 'scatter', mode: 'lines', x: sd.x, y: sd.p90, fill: 'tonexty', fillcolor: 'rgba(0,34,78,0.12)',
        line: { width: 0 }, name: `usual range (P10–P90, ${years[0]}–${years[years.length - 1]})`, hoverinfo: 'skip',
      },
      {
        type: 'scatter', mode: 'lines', x: sd.x, y: sd.p50, name: 'median', line: { color: '#00224e', width: 2, dash: 'dash' },
        text: hover('median', sd.p50), hovertemplate: '%{text}<extra></extra>',
      },
      {
        type: 'scatter', mode: 'lines+markers', x: sd.x.slice(0, sd.current.length), y: sd.current, name: String(sd.year),
        line: { color: '#e8432e', width: 3 }, marker: { size: sd.current.map((_, k) => (k === sd.current.length - 1 ? 9 : 4)) },
        text: hover(String(sd.year), sd.current), hovertemplate: '%{text}<extra></extra>',
      },
    ] as Partial<Plotly.Data>[];
    const layout: Partial<Plotly.Layout> = {
      height: 320,
      margin: { l: 60, r: 10, t: 10, b: 40 },
      paper_bgcolor: 'rgba(0,0,0,0)',
      plot_bgcolor: 'rgba(0,0,0,0)',
      font: { family: 'system-ui, sans-serif', size: 12, color: '#24292f' },
      xaxis: {
        fixedrange: true, range: [0, 365], showgrid: false,
        tickvals: [0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334].map((v) => v + 15), ticktext: MONTHS,
      },
      yaxis: { fixedrange: true, title: { text: 'cell-days since 1 Jan' }, rangemode: 'tozero', gridcolor: '#e5e8ec' },
      legend: { orientation: 'h', x: 0, y: 1.02, yanchor: 'bottom' },
      hovermode: 'closest',
    };
    await Plotly.react(seasonEl, data as Plotly.Data[], layout, {
      responsive: true, displaylogo: false,
      modeBarButtonsToRemove: ['zoom2d', 'pan2d', 'select2d', 'lasso2d', 'zoomIn2d', 'zoomOut2d', 'autoScale2d', 'resetScale2d'],
      toImageButtonOptions: { filename: `seamless-fire-${country.code}-${areaSlug(state.area)}-season` },
    });
    const l = sd.last;
    $('season-note').innerHTML = l
      ? `By ${doyLabel(l.x)} ${sd.year}: <b>${fmt(l.value)}</b> cell-days since 1 January` +
        (l.ratio !== null ? `, <b>${l.ratio >= 10 ? l.ratio.toFixed(0) : l.ratio.toFixed(1)}×</b> the median of ${l.nYears} earlier years` : '') +
        ` (above ${Math.round(l.percentile)}% of them). ` +
        (partial ? `The last point is month to date; earlier years are counted to the same day. ` : '') +
        `Thin grey lines: single years (hover). 2022 includes the S-NPP outage (Jul–Aug); January 2012 is estimated from MODIS.`
      : 'Not enough data for this view.';
  }

  // ------------------------------------------------------------------ next 7 days

  interface ForecastDay { date: string; value: number; lo: number; hi: number; typical: number; fwi: number; skill: number }
  interface Forecast {
    issued: string; data_through: string; weather_state: string; days: ForecastDay[]; points?: ForecastPoint[];
    week: { value: number; typical: number; lo: number; hi: number; skill: number; corr: number; corr_typical: number };
    perfect_skill: number; trained: string; tested: string; sources: string;
  }
  const forecastCache = new Map<string, Promise<Forecast | null>>();
  let forecastToken = 0;

  function loadForecast(code: string): Promise<Forecast | null> {
    let pr = forecastCache.get(code);
    if (!pr) {
      // no file = no validated forecast for this country (not an error)
      pr = fetch(dataUrl(`${code}/forecast.json`)).then((r) => (r.ok ? (r.json() as Promise<Forecast>) : null));
      pr.catch(() => forecastCache.delete(code));
      forecastCache.set(code, pr);
    }
    return pr;
  }

  async function renderForecast() {
    if (!current || (forecastEl.closest('.tab') as HTMLElement).hidden) {
      areaMap?.setWatch(null); // markers belong to the open tab and the current area
      return; // hidden tab: rendered when shown
    }
    const token = ++forecastToken;
    const { country } = current;
    const head = $('forecast-head');
    const note = $('forecast-note');
    const Plotly = await plotly();
    const clear = (msg: string) => {
      Plotly.purge(forecastEl);
      forecastEl.hidden = true;
      head.textContent = '';
      note.innerHTML = msg;
    };
    if (country.code === WORLD_CODE) {
      void renderWatch(null);
      return clear('The forecast is made per country: choose one country.');
    }
    let f: Forecast | null = null;
    try {
      f = await loadForecast(country.code);
    } catch (err) {
      console.error(err);
      if (token === forecastToken) clear('The forecast could not be loaded. Try again later.');
      return;
    }
    if (token !== forecastToken || !current) return;
    if (!f) {
      void renderWatch(null);
      return clear(`No forecast for ${escapeHtml(country.name)}: its fire weather model did not beat the seasonal normal when
        tested on real archived weather forecasts (2024–2025), so it is not shown. In Australia and Canada one weather average
        for a whole continent explains little of the daily fire activity. Places to watch below use the fire history only.`);
    }
    forecastEl.hidden = false;
    const label = (iso: string) => {
      const dt = new Date(`${iso}T00:00:00Z`);
      return `${['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'][dt.getUTCDay()]} ${dt.getUTCDate()} ${MONTHS[dt.getUTCMonth()]}`;
    };
    const x = f.days.map((d) => label(d.date));
    const w = f.week;
    const r = (w.value + 1) / (w.typical + 1);
    const word = r >= 1.25 ? 'above' : r <= 0.8 ? 'below' : 'close to';
    const dShort = (iso: string) => { const dt = new Date(`${iso}T00:00:00Z`); return `${dt.getUTCDate()} ${MONTHS[dt.getUTCMonth()]}`; };
    head.innerHTML = `${escapeHtml(country.name)}, the 7 days after the last data day (${dShort(f.data_through)}): about <b>${fmt(w.value)}</b> fire cell-days
      (80% range ${fmt(w.lo)}–${fmt(w.hi)}), <b>${word}</b> the typical ${fmt(w.typical)} for these days.` +
      (current.h.area ? ' <span class="flag">whole country, not the selected area</span>' : '') +
      (Date.now() - Date.parse(`${f.issued}T00:00:00Z`) >= 86_400_000
        ? ` <span class="flag">forecast made on ${dShort(f.issued)} with that day's weather forecast; some of these days are already past</span>` : '');
    const data: Partial<Plotly.Data>[] = [
      {
        type: 'bar', name: 'expected', x, y: f.days.map((d) => d.value), marker: { color: '#e8432e' },
        error_y: {
          type: 'data', symmetric: false, color: '#57606a', thickness: 1.2, width: 4,
          array: f.days.map((d) => d.hi - d.value), arrayminus: f.days.map((d) => d.value - d.lo),
        },
        text: f.days.map((d) => `<b>${label(d.date)}</b><br>expected ${fmt(d.value)} (80%: ${fmt(d.lo)}–${fmt(d.hi)})<br>typical day ${fmt(d.typical)}<br>Fire Weather Index ${d.fwi.toFixed(1)}<br>measured skill ${Math.round(d.skill * 100)}%`),
        hovertemplate: '%{text}<extra></extra>', textposition: 'none',
      } as Partial<Plotly.Data>,
      {
        type: 'scatter', mode: 'lines+markers', name: 'typical day (2012–2025)', x, y: f.days.map((d) => d.typical),
        line: { color: '#00224e', width: 2, dash: 'dash' }, marker: { size: 5 }, hoverinfo: 'skip',
      },
    ];
    const layout: Partial<Plotly.Layout> = {
      height: 300,
      margin: { l: 60, r: 10, t: 10, b: 40 },
      paper_bgcolor: 'rgba(0,0,0,0)',
      plot_bgcolor: 'rgba(0,0,0,0)',
      font: { family: 'system-ui, sans-serif', size: 12, color: '#24292f' },
      xaxis: { fixedrange: true },
      yaxis: { fixedrange: true, title: { text: 'cell-days per day' }, rangemode: 'tozero', gridcolor: '#e5e8ec' },
      legend: { orientation: 'h', x: 0, y: 1.02, yanchor: 'bottom' },
      bargap: 0.35,
    };
    await Plotly.react(forecastEl, data as Plotly.Data[], layout, {
      responsive: true, displaylogo: false,
      modeBarButtonsToRemove: ['zoom2d', 'pan2d', 'select2d', 'lasso2d', 'zoomIn2d', 'zoomOut2d', 'autoScale2d', 'resetScale2d'],
      toImageButtonOptions: { filename: `seamless-fire-${country.code}-forecast-${f.issued}` },
    });
    if (token !== forecastToken) return;
    const sk = f.days.map((d) => `${Math.round(d.skill * 100)}%`);
    note.innerHTML = `Issued ${f.issued}, continuing from the fire data through ${f.data_through}. Expected value = the model's typical outcome for the forecast weather (a median, so
      single big fire days can be much higher); bars show the 80% range. The model links daily fire activity to the
      Canadian Fire Weather Index and weather where fires usually happen, beyond the normal seasonal level.
      <b>Measured skill</b> on real archived forecasts (${f.tested.replace('..', '–')}), improvement over the typical day:
      day 1 ${sk[0]}, day 3 ${sk[2]}, day 5 ${sk[4]}, day 7 ${sk[6]}${f.week.skill < 0.1 ? '; the 7-day total adds little to the typical level here' : ''}.
      Weather: NASA POWER (fire weather state to ${f.weather_state}) and forecasts from
      <a href="https://open-meteo.com/" target="_blank" rel="noopener">Open-Meteo.com</a> (CC BY 4.0).`;
    void renderWatch(f);
  }

  // Places to watch: recurrence at this time of year × local fire weather (src/lib/watch.ts).
  let watchToken = 0;

  async function renderWatch(f: Forecast | null) {
    const el = $('watch');
    const token = ++watchToken;
    if (!current || current.country.code === WORLD_CODE) {
      el.innerHTML = '';
      areaMap?.setWatch(null);
      return;
    }
    const { country, d } = current;
    const info = d.model.live as LiveInfo | undefined;
    const lastDay = info?.last ?? `${d.model.last_complete_month}-${daysInMonth(d.model.last_complete_month)}`;
    const days = f ? f.days.map((x) => x.date) : Array.from({ length: 7 }, (_, i) => addDays(lastDay, i + 1));
    const weights = seasonWeights(days);
    alignMapWithForecast(days);
    const shape = resolveShape(state.area);
    const label = areaLabel(state.area) ?? country.name;
    el.innerHTML = '<p class="note">Finding places to watch…</p>';
    try {
      const meta = await loadRec<RecurrenceMeta>(`${country.code}/recurrence/meta.json`);
      const months = await Promise.all([...weights.keys()].map(async (cal) => ({
        cal, data: await loadRec<RecurrenceMonth>(`${country.code}/recurrence/m${String(cal + 1).padStart(2, '0')}.json`),
      })));
      if (token !== watchToken || !current) return;
      const pts = f?.points ?? null;
      const places = watchPlaces(meta, months, weights, shape ? keepFn(shape) : null, pts, 10);
      const cals = [...weights.keys()].sort((a, b) => a - b);
      // months in time order (a window across the new year: Dec before Jan)
      const ordered = cals.some((c) => c === 0) && cals.some((c) => c === 11)
        ? [...cals.filter((c) => c >= 6), ...cals.filter((c) => c < 6)] : cals;
      const season = `${MONTHS[ordered[0]]}–${MONTHS[ordered[ordered.length - 1]]}`;
      const plural = (c: number) => (c === 2 ? 'Marches' : `${MONTHS_LONG[c]}s`);
      // weather around the area: at the centre of the area (or of the country)
      const [w0, s0, e0, n0] = shape ? shapeBBox(shape) : country.bbox;
      const lw = pts ? localWeather(pts, (s0 + n0) / 2, (w0 + e0) / 2) : null;
      const mean = (v: number[]) => v.reduce((a, b) => a + b, 0) / v.length;
      const wxLine = lw
        ? `Fire weather around ${escapeHtml(label)} in these 7 days: <b>${factorWord(mean(lw.factor))}</b>
           (×${mean(lw.factor).toFixed(2)} the usual activity for the season; mean FWI ${mean(lw.fwi).toFixed(1)}).`
        : `No fire weather forecast for ${escapeHtml(country.name)}: places are ranked by history only.`;
      const deg = (v: number, pos: string, neg: string) => `${Math.abs(v).toFixed(3)}° ${v < 0 ? neg : pos}`;
      const osm = (p: { lat: number; lon: number }) =>
        `https://www.openstreetmap.org/?mlat=${p.lat.toFixed(4)}&mlon=${p.lon.toFixed(4)}#map=15/${p.lat.toFixed(4)}/${p.lon.toFixed(4)}`;
      const main = mainSeason(monthProfile(current.h, 0, current.h.value.length - 1).share);
      if (!places.length) {
        el.innerHTML = `<h3>Places to watch in ${escapeHtml(label)}</h3><p>${wxLine}</p>
          <p>No ~1 km cell here had vegetation fire in 2 or more years in ${season} (VIIRS, since 2012): fire is rare
          here at this time of year.${main ? ` The main fire months in ${escapeHtml(label)} are <b>${monthsText(main.months)}</b>
          (${Math.round(main.share * 100)}% of the yearly activity).` : ''}</p>`;
        areaMap?.setWatch(null);
        return;
      }
      const rows = places.map((p, i) => `<tr${i >= 3 ? ' class="more"' : ''}><td>${i + 1}</td>
          <td><a href="${osm(p)}" target="_blank" rel="noopener">${deg(p.lat, 'N', 'S')}, ${deg(p.lon, 'E', 'W')}</a></td>
          <td>${Math.round(p.recurrence * 100)}%</td>
          <td>${p.factor === null ? '–' : `×${p.factor.toFixed(2)}`}</td></tr>`).join('');
      el.innerHTML = `<h3>Places to watch in ${escapeHtml(label)}, ${shortDay(days[0])}–${shortDay(days[days.length - 1])}</h3>
        <p class="watch-lead"><b>A ranking of places to watch, not a probability of fire.</b> Numbers match the markers on the map.</p>
        <div class="table-wrap"><table class="anom watch-table"><thead><tr><th>#</th><th>Place (~1 km cell, opens the map)</th>
          <th>Years with fire, ${season}</th><th>Weather</th></tr></thead><tbody>${rows}</tbody></table></div>
        ${places.length > 3 ? `<button type="button" class="watch-more" aria-expanded="false">Show all ${places.length} places</button>` : ''}
        <p>${wxLine}</p>
        <p class="note">Ranked by how often vegetation fire happened in the cell at this time of year (share of years,
          ${season}; the months next to the forecast days count half; VIIRS S-NPP, since 2012)
          ${pts ? '× the local fire weather of these 7 days (×1 = usual for the season; nearest forecast points)' : ''}.
          Year-round fire (likely industrial) is left out.</p>`;
      el.querySelector<HTMLButtonElement>('.watch-more')?.addEventListener('click', (e) => {
        const b = e.currentTarget as HTMLButtonElement;
        const open = el.querySelector('.watch-table')!.classList.toggle('all');
        b.setAttribute('aria-expanded', String(open));
        b.textContent = open ? 'Show top 3 only' : `Show all ${places.length} places`;
      });
      areaMap?.setWatch(places.map((p, i) => ({
        lat: p.lat, lon: p.lon,
        info: `<b>Place to watch ${i + 1}</b><br>` + p.byMonth.map((m) => `Fire in ${m.years} of ${m.of} ${plural(m.cal)}`).join('<br>') + ' (VIIRS)' +
          (p.factor !== null ? `<br>Fire weather next 7 days: ×${p.factor.toFixed(2)} usual, FWI ${p.fwi!.toFixed(1)}` : '') +
          `<br>${p.lat.toFixed(3)}°, ${p.lon.toFixed(3)}°`,
      })), `Numbered: places to watch, ${shortDay(days[0])}–${shortDay(days[days.length - 1])} (forecast week)`);
    } catch (err) {
      console.error(err);
      if (token === watchToken) el.innerHTML = '<p class="note">Places to watch could not be loaded.</p>';
    }
  }

  /**
   * The forecast tab shows forecast markers over the map layer; keep that layer about the same time of
   * year: Recurrence follows the forecast's calendar month, "Month" shows the latest month.
   */
  function alignMapWithForecast(days: string[]) {
    if (!current || !days.length) return;
    if (mapMode === 'recur') {
      const cal = Number(days[Math.floor(days.length / 2)].slice(5, 7)) - 1;
      if (cal !== recMonth) { recMonth = cal; updateMapLayer(); }
    } else if (mapMode === 'month') {
      const first = monthAbs(current.h.firstMonth);
      const last = first + current.h.value.length - 1;
      if (selAbs !== last && last <= first + current.toIdx) { selAbs = last; updateMapLayer(); }
    }
  }

  function shortDay(iso: string): string {
    const dt = new Date(`${iso}T00:00:00Z`);
    return `${dt.getUTCDate()} ${MONTHS[dt.getUTCMonth()]}`;
  }

  // ------------------------------------------------------------------ anomalies

  function renderAnomalies(h: Harmonized, fromIdx: number, toIdx: number) {
    const top = topAnomalies(h, fromIdx, toIdx, 10);
    if (!top.length) {
      anomEl.innerHTML = '<p class="note">Not enough history in the selected period.</p>';
      return;
    }
    const maxR = Math.max(...top.map((a) => a.rankRatio));
    const anyFlag = top.some((a) => a.estimated || a.preliminary || a.lowQuality);
    const rows = top.map((a, i) => {
      const flags = [
        a.estimated ? 'estimated' : '',
        a.preliminary ? 'preliminary' : '',
        a.lowQuality ? 'sensor problem' : '',
      ].filter(Boolean).join(', ');
      const r = a.rankRatio;
      return `<tr data-month="${a.month}" title="Show on the map"><td>${i + 1}</td><td>${shortMonth(a.month)}</td><td>${fmt(a.value)}</td>
        <td class="bar-cell"><span class="bar" style="width:${((r / maxR) * 100).toFixed(1)}%"></span><b>${a.estimated ? '≥' : ''}${r >= 10 ? r.toFixed(0) : r.toFixed(1)}</b></td>
        <td>${fmt(a.median!)}</td><td>${Math.round(a.percentile)}% of years</td>${anyFlag ? `<td class="flags">${flags}</td>` : ''}</tr>`;
    });
    anomEl.innerHTML = `<div class="table-wrap"><table class="anom">
      <thead><tr><th>#</th><th>Month</th><th>Cell-days</th><th title="(value + k) / (median + k); 1 = typical. Not a plain ratio: k keeps tiny counts from exploding.">Anomaly index ⓘ</th><th>Typical</th>
      <th title="Share of the same calendar month in all years that was lower">Higher than</th>${anyFlag ? '<th>Notes</th>' : ''}</tr></thead><tbody>${rows.join('')}</tbody></table></div>`;
  }

  // ------------------------------------------------------------------ export

  function download(name: string, text: string, type = 'text/csv;charset=utf-8') {
    const url = URL.createObjectURL(new Blob([text], { type }));
    const a = document.createElement('a');
    a.href = url;
    a.download = name;
    document.body.append(a);
    a.click();
    a.remove();
    setTimeout(() => URL.revokeObjectURL(url), 1000);
  }

  /** How the area of the report is defined (one sentence). */
  function areaNoteText(country: Country): string {
    const a = state.area;
    const f = (v: number) => v.toFixed(3);
    if (country.code === WORLD_CODE) return 'Area: all eight countries, each harmonized with its own model, then summed.';
    if (a.kind === 'country') return `Area: ${country.name}, whole country (FIRMS country files; near real-time points assigned with Natural Earth borders).`;
    if (a.kind === 'preset') {
      const p = PRESETS.find((x) => x.id === a.id);
      return `Area: preset "${p?.name ?? a.id}"${p?.note ? ` (${p.note})` : ''}, in ${country.name}.`;
    }
    const [w, s, e, n] = shapeBBox(a.shape);
    return a.shape.kind === 'rect'
      ? `Area: rectangle W ${f(w)}, S ${f(s)}, E ${f(e)}, N ${f(n)} (degrees), in ${country.name}.`
      : `Area: polygon with ${a.shape.ring.length} vertices drawn on the map (bounding box W ${f(w)}, S ${f(s)}, E ${f(e)}, N ${f(n)}), in ${country.name}.`;
  }

  let reportBusy = false;

  async function startReport() {
    if (!current || reportBusy) return;
    reportBusy = true;
    dlReport.disabled = true;
    dlStatus.textContent = 'Preparing the area report…';
    try {
      const { country, d, h, fromIdx, toIdx, parts } = current;
      const world = country.code === WORLD_CODE;
      const first = monthAbs(h.firstMonth);
      const shape = world ? null : resolveShape(state.area);
      const label = areaLabel(state.area);
      const annual = parts
        ? sumAnnual(parts.map((p) => ({ h: p.h, model: p.d.model })), fromIdx, toIdx)
        : annualTotals(h, d.model, fromIdx, toIdx);
      // Month to date and season to date: same days of earlier years from the daily history.
      const info = d.model.live as LiveInfo | undefined;
      const idx = h.value.length - 1;
      let mtd = null;
      let partial: { day: number; hist: Map<number, number> } | null = null;
      if (h.partial[idx] && info) {
        try {
          const { hist, days } = await sameDaysTotals(d, info);
          mtd = mtdStats(h.value[idx], hist, info, d.model, days.size, monthStats(h, idx).k);
          partial = { day: info.throughDay, hist };
        } catch (err) {
          console.error(err); // the report still has the full months
        }
      }
      const hs = partial || !h.partial[idx] ? h : { ...h, value: h.value.slice(0, idx), partial: h.partial.slice(0, idx) };
      const season = seasonData(hs, seasonYears(h, d.model.viirs_first_month), partial);
      // Places where fire comes back: recurrence files of the main fire months (one country only).
      let places: Places | null = null;
      if (!world) {
        const months = placeMonths(monthProfile(h, fromIdx, toIdx));
        if (months.length) {
          try {
            const meta = await loadRec<RecurrenceMeta>(`${country.code}/recurrence/meta.json`);
            const data = await Promise.all(months.map((c) =>
              loadRec<RecurrenceMonth>(`${country.code}/recurrence/m${String(c + 1).padStart(2, '0')}.json`)));
            places = placesInArea(meta, months.map((cal, k) => ({ cal, data: data[k] })), shape ? keepFn(shape) : null);
          } catch (err) {
            console.error(err); // report without the places section
          }
        }
      }
      const now = new Date().toISOString();
      const html = reportHtml({
        title: `${label ? `${label}, ` : ''}${country.name}`,
        areaNote: areaNoteText(country),
        shape,
        isArea: h.area,
        h, model: d.model, fromIdx, toIdx, annual, mtd, season, places,
        appUrl: location.href.split('#')[0] + serializeHash({ ...state, view: undefined }),
        generated: `${now.slice(0, 10)} ${now.slice(11, 16)}`,
        dataThrough: info?.last ?? String((d.model.last_data as Record<string, string> | undefined)?.SNPP ?? d.model.last_complete_month),
        modelNote: world
          ? 'each country with its own model'
          : `${country.name}: model ${d.model.model === 'E' ? 'with seasonal intercepts' : 'with one intercept'}, b = ${d.model.b.toFixed(3)}`,
      });
      download(
        `seamless-fire_${country.code}_${areaSlug(state.area)}_${monthStr(first + fromIdx)}_${monthStr(first + toIdx)}_report.html`,
        html, 'text/html;charset=utf-8',
      );
      dlStatus.textContent = 'Area report saved. Open it in a browser; print it to save a PDF.';
    } catch (err) {
      console.error(err);
      dlStatus.textContent = 'The area report could not be made. Try again.';
    } finally {
      reportBusy = false;
      dlReport.disabled = false;
    }
  }

  function updateExportNote() {
    if (!current) return;
    const { d, country } = current;
    if (country.code === WORLD_CODE) {
      dlHotspots.disabled = true;
      dlNote.textContent = 'Hotspot files are per country: choose one country to download them.';
      return;
    }
    if (!d.model.hotspots) {
      dlHotspots.disabled = true;
      dlNote.innerHTML = `Hotspot files for ${escapeHtml(country.name)} are too large for this site. ` +
        `Download them from <a href="${FIRMS_URL}" target="_blank" rel="noopener">NASA FIRMS</a>.`;
      return;
    }
    dlHotspots.disabled = !!exportJob;
    dlNote.textContent =
      'Hotspots are filtered by their own coordinates, the series by 0.1° cell centers, so counts can differ ' +
      'slightly at the area edge. Hotspots are vegetation fires only (industrial sources removed); ' +
      '2026 has VIIRS only.';
  }

  async function startHotspotExport() {
    if (!current || exportJob) return;
    // Snapshot of the state at start: later changes on the page do not affect this file.
    const { d, country, h, fromIdx, toIdx } = current;
    const first = monthAbs(h.firstMonth);
    const from = monthStr(first + fromIdx);
    const to = monthStr(first + toIdx);
    const shape = resolveShape(state.area);
    const keep = shape ? keepFn(shape) : null;
    const files = hotspotFiles(d.model, from, to);
    const name = `seamless-fire_${country.code}_${areaSlug(state.area)}_${from}_${to}_hotspots.csv`;
    const job = new AbortController();
    exportJob = job;
    dlHotspots.disabled = true;
    dlCancel.hidden = false;
    dlStatus.textContent = `Hotspots: file 0 of ${files.length}…`;
    try {
      const res = await exportHotspots({
        code: country.code, files, keep, from, to, signal: job.signal,
        fetchText: async (path, signal) => {
          const r = await fetch(dataUrl(path), { signal });
          if (!r.ok) throw new Error(`${path}: HTTP ${r.status}`);
          return r.text();
        },
        onProgress: (done, total, rows) => {
          dlStatus.textContent = `Hotspots: file ${done} of ${total}, ${rows.toLocaleString('en-US')} rows…`;
        },
      });
      download(name, res.csv);
      dlStatus.textContent = `Saved ${res.rows.toLocaleString('en-US')} hotspots.`;
    } catch (err) {
      if (job.signal.aborted) dlStatus.textContent = 'Hotspot download cancelled, no file saved.';
      else {
        console.error(err);
        dlStatus.textContent = 'Hotspot download failed, no file saved. Check the connection and try again.';
      }
    } finally {
      exportJob = null;
      dlCancel.hidden = true;
      updateExportNote();
    }
  }

  // ------------------------------------------------------------------ map layer

  /** Fire cells for the selected month (or the whole period) and the calendar marker. */
  function updateMapLayer() {
    if (!current || selAbs === null) return;
    const label = $('map-month');
    const { d, hc, fromIdx, toIdx } = current;
    const first = monthAbs(hc.firstMonth);
    const i = selAbs - first;
    let title: string;
    if (mapMode === 'month') {
      const live = d.model.live as LiveInfo | undefined;
      const kind = hc.estimated[i] ? 'estimated from MODIS'
        : hc.partial[i] && live ? `NOAA-20, 1–${live.throughDay} so far`
        : selAbs > monthAbs(d.model.last_complete_month) ? 'NOAA-20, near real-time'
        : hc.preliminary[i] ? 'VIIRS, preliminary' : 'observed VIIRS';
      title = `${monthLabel(monthStr(selAbs))} · ${kind}`;
      label.textContent = monthLabel(monthStr(selAbs));
    } else if (mapMode === 'recur') {
      title = MONTHS_LONG[recMonth];
      label.textContent = MONTHS_LONG[recMonth];
    } else {
      const span = `${shortMonth(monthStr(first + fromIdx))} – ${shortMonth(monthStr(first + toIdx))}`;
      title = `${span} · ${toIdx - fromIdx + 1 >= 12 ? 'average per year' : 'total in the period'}`;
      label.textContent = 'Whole period';
    }
    $('month-step').hidden = mapMode === 'period';
    updateHotspots();
    $<HTMLButtonElement>('map-prev').disabled = mapMode === 'period' || (mapMode === 'month' && i <= fromIdx);
    $<HTMLButtonElement>('map-next').disabled = mapMode === 'period' || (mapMode === 'month' && i >= toIdx);
    markCalendar();
    if (!areaMap) return;
    // "All countries": each country's cells with its own shares, merged.
    const layerFor = (a: number, b: number) => current!.parts
      ? mergeLayers(current!.parts.map((p) => cellLayer(p.d.cells, p.hc, a, b)))
      : cellLayer(d.cells, hc, a, b);
    if (mapMode !== 'recur') areaMap.setYearRound(null, '');
    if (mapMode === 'month') {
      areaMap.setCells(layerFor(i, i), title, MAP_SCALE.month);
    } else if (mapMode === 'recur') {
      showRecurrence();
      return;
    } else {
      // Whole period: average per year, so the colour scale does not depend on the period length.
      // Periods under 12 months: total in the period on the month scale (scaling a few months up
      // to a year would make single detections look like hot spots).
      const layer = layerFor(fromIdx, toIdx);
      if (layer.months < 12) {
        areaMap.setCells(layer, title, MAP_SCALE.short);
        return;
      }
      const perYear = 12 / layer.months;
      for (let j = 0; j < layer.value.length; j++) layer.value[j] *= perYear;
      layer.max *= perYear;
      layer.total *= perYear;
      areaMap.setCells(layer, title, MAP_SCALE.period);
    }
  }

  // Recurrence layer: {CC}/recurrence/meta.json + mNN.json (0.01° grid, full S-NPP record),
  // loaded on first use and cached.
  const recCache = new Map<string, Promise<unknown>>();
  let recToken = 0;

  function loadRec<T>(path: string): Promise<T> {
    let pr = recCache.get(path) as Promise<T> | undefined;
    if (!pr) {
      pr = fetchJson<T>(path);
      pr.catch(() => recCache.delete(path));
      recCache.set(path, pr);
    }
    return pr;
  }

  async function showRecurrence() {
    if (!areaMap || !current) return;
    const token = ++recToken;
    const month = recMonth;
    const name = MONTHS_LONG[month];
    const scale0 = MAP_SCALE.recur(0, name);
    const codes = current.parts ? current.parts.map((p) => p.d.code) : [current.country.code];
    areaMap.setCells(null, `${name} · loading fire recurrence…`, scale0);
    try {
      const mm = String(month + 1).padStart(2, '0');
      const loaded = await Promise.all(codes.map((c) => Promise.all([
        loadRec<RecurrenceMeta>(`${c}/recurrence/meta.json`),
        loadRec<RecurrenceMonth>(`${c}/recurrence/m${mm}.json`),
      ])));
      if (token !== recToken || mapMode !== 'recur' || !areaMap) return;
      const parts = loaded.map(([meta, data]) => recurrenceLayer(meta, data, month));
      const rings: YearRoundCell[] = loaded.flatMap(([meta]) => yearRoundCells(meta));
      const r = parts[0];
      const minYears = loaded[0][0].min_years;
      areaMap.setYearRound(rings, rings.length
        ? `Year-round fire, likely industrial (${rings.length.toLocaleString('en-US')}): click a ring`
        : 'No year-round fire spots', loaded[0][0].cell_deg);
      if (!r.years) {
        areaMap.setCells(null, `${name} · no VIIRS ${name}s to count`, scale0);
        return;
      }
      const layer = parts.length > 1 ? mergeLayers(parts) : r;
      // A border cell can appear in two countries' files: cap at 100%.
      for (let j = 0; j < layer.value.length; j++) layer.value[j] = Math.min(layer.value[j], 100);
      const span = r.firstYear === r.lastYear ? `${r.firstYear}` : `${r.firstYear}–${r.lastYear}`;
      areaMap.setCells(layer, `${name} · fire recurrence, ${r.years} years ${span}`, MAP_SCALE.recur(r.years, name, minYears));
    } catch (err) {
      console.error(err);
      if (token === recToken && areaMap) areaMap.setCells(null, `${name} · recurrence data could not be loaded`, scale0);
    }
  }

  // Hotspot points of the month on the map: yearly files, cached per country and year.
  const hotCache = new Map<string, Promise<Hotspot[]>>();
  let hotToken = 0;

  /** One hotspot file: a year ("2020") or the live period ("live"). */
  function loadHotYear(code: string, year: number | string): Promise<Hotspot[]> {
    const key = `${code}/${year}`;
    let pr = hotCache.get(key);
    if (!pr) {
      pr = fetch(dataUrl(`${code}/hotspots/${year}.csv`))
        .then((r) => {
          if (!r.ok) throw new Error(`hotspots ${key}: ${r.status}`);
          return r.text();
        })
        .then((text) => text.split(/\r?\n/).slice(1).filter(Boolean).map((line) => {
          const f = line.split(',');
          return { date: f[0], time: f[1], lat: Number(f[2]), lon: Number(f[3]), sensor: f[4], frp: Number(f[5]) };
        }));
      pr.catch(() => hotCache.delete(key));
      hotCache.set(key, pr);
    }
    return pr;
  }

  async function updateHotspots() {
    if (!areaMap || !current || selAbs === null) return;
    const token = ++hotToken;
    const { country, d } = current;
    const on = $<HTMLInputElement>('show-hot').checked;
    if (!on || mapMode !== 'month') {
      areaMap.setHotspots(null, on ? 'Hotspot points: choose "Month"' : '');
      return;
    }
    if (country.code === WORLD_CODE) {
      areaMap.setHotspots(null, 'Hotspot points: choose one country');
      return;
    }
    const ym = monthStr(selAbs);
    if (!d.model.hotspots) {
      areaMap.setHotspots(null, 'Hotspot points: too large for this site, see FIRMS');
      return;
    }
    const files = hotspotFiles(d.model, ym, ym);
    if (!files.length) {
      areaMap.setHotspots(null, 'No hotspot points for this month');
      return;
    }
    areaMap.setHotspots(null, 'Loading hotspot points…');
    try {
      const all = (await Promise.all(files.map((f) => loadHotYear(country.code, f)))).flat();
      if (token !== hotToken) return;
      const pts = all.filter((p) => p.date.startsWith(ym));
      const n = (v: number) => v.toLocaleString('en-US');
      const shape = resolveShape(state.area);
      let note = `${n(pts.length)} hotspot detections (vegetation, all sensors) in the whole country, click a point`;
      if (shape) {
        const keep = keepFn(shape);
        const inside = pts.reduce((c, p) => c + (keep(p.lat, p.lon) ? 1 : 0), 0);
        note = `Hotspot points (all sensors): ${n(pts.length)} in the whole country, <b>${n(inside)} inside the area outline</b>; click a point`;
      }
      areaMap.setHotspots(pts, note);
    } catch {
      if (token === hotToken) areaMap.setHotspots(null, 'Hotspot points could not be loaded');
    }
  }

  /** Red square on the calendar month shown on the map (trace 3). */
  function markCalendar() {
    const gd = calEl as unknown as { data?: unknown[] };
    if (!gd.data || gd.data.length < 4 || selAbs === null || !plotlyPromise) return;
    const on = mapMode === 'month';
    const x = on ? [selAbs % 12] : [];
    const y = on ? [Math.floor(selAbs / 12)] : [];
    plotlyPromise.then((Plotly) => Plotly.restyle(calEl, { x: [x], y: [y] } as unknown as Plotly.Data, [3]));
  }

  function selectMonth(abs: number) {
    if (!current) return;
    const first = monthAbs(current.h.firstMonth);
    selAbs = Math.min(Math.max(abs, first + current.fromIdx), first + current.toIdx);
    if (mapMode === 'recur') { // stay in recurrence, follow the clicked calendar month
      recMonth = ((abs % 12) + 12) % 12;
      updateMapLayer();
      return;
    }
    mapMode = 'month';
    document.querySelectorAll<HTMLInputElement>('input[name=mapmode]').forEach((r) => (r.checked = r.value === 'month'));
    updateMapLayer();
  }

  // ------------------------------------------------------------------ panels

  function mapPadding(): { topLeft: [number, number]; bottomRight: [number, number] } {
    // nothing floats over the map; leave room for the legend in the bottom-left corner
    return { topLeft: [12, 12], bottomRight: [12, 24] };
  }

  /** Re-render the calendar so its rows fit the new panel height. */
  function rerenderCalendar() {
    if (!current) return;
    const { country, d, h, fromIdx, toIdx } = current;
    renderCalendar(country, d, state.view === 'raw' ? rawSplice(h, d.model) : h, fromIdx, toIdx);
  }

  function resizeCharts() {
    if (!plotlyPromise) return;
    plotlyPromise.then((Plotly) => {
      for (const el of [calEl, annualEl, seasonEl, forecastEl]) {
        if (el.offsetParent && (el as unknown as { data?: unknown }).data) Plotly.Plots.resize(el);
      }
    });
    areaMap?.resize();
  }

  function initPanels() {
    const tabs = [...document.querySelectorAll<HTMLButtonElement>('.dock-tabs [role=tab]')];
    const bodies = [...document.querySelectorAll<HTMLElement>('.dock-body .tab')];
    tabs.forEach((t) => t.addEventListener('click', () => {
      tabs.forEach((x) => x.setAttribute('aria-selected', String(x === t)));
      bodies.forEach((b) => (b.hidden = b.dataset.tab !== t.dataset.tab));
      if (t.dataset.tab === 'calendar') rerenderCalendar();
      if (t.dataset.tab === 'season') void renderSeason();
      if (t.dataset.tab === 'forecast') void renderForecast();
      else areaMap?.setWatch(null);
      resizeCharts();
    }));
    const left = $('panel-left');
    $('toggle-left').addEventListener('click', () => {
      const closed = left.classList.toggle('collapsed');
      $('toggle-left').textContent = closed ? '›' : '‹';
      $('toggle-left').title = closed ? 'Show controls' : 'Hide controls';
      $('toggle-left').setAttribute('aria-expanded', String(!closed));
      resizeCharts();
    });
    let resizeTimer = 0;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(rerenderCalendar, 200);
    });
    // Browsers may restore radio states on reload; the map mode always starts at "One month".
    document.querySelectorAll<HTMLInputElement>('input[name=mapmode]').forEach((r) => (r.checked = r.value === mapMode));
    document.querySelectorAll<HTMLInputElement>('input[name=mapmode]').forEach((r) => r.addEventListener('change', () => {
      mapMode = r.value as MapMode;
      if (mapMode === 'recur' && selAbs !== null) recMonth = selAbs % 12;
      updateMapLayer();
    }));
    $('show-hot').addEventListener('change', () => updateHotspots());
    document.querySelectorAll<HTMLButtonElement>('button[data-cal]').forEach((b) => b.addEventListener('click', () => {
      calMode = b.dataset.cal as 'value' | 'anom';
      document.querySelectorAll<HTMLButtonElement>('button[data-cal]')
        .forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.cal === calMode)));
      if (current) syncView(current.h, current.d);
      rerenderCalendar();
    }));
    document.querySelectorAll<HTMLButtonElement>('button[data-smooth]').forEach((b) => b.addEventListener('click', () => {
      const on = b.dataset.smooth === '1';
      document.querySelectorAll<HTMLButtonElement>('button[data-smooth]')
        .forEach((x) => x.setAttribute('aria-pressed', String((x.dataset.smooth === '1') === on)));
      areaMap?.setSmooth(on);
    }));
    const step = (dir: number) => {
      if (mapMode === 'recur') {
        recMonth = (recMonth + dir + 12) % 12;
        updateMapLayer();
      } else if (selAbs !== null) selectMonth(selAbs + dir);
    };
    $('map-prev').addEventListener('click', () => step(-1));
    $('map-next').addEventListener('click', () => step(1));
    anomEl.addEventListener('click', (ev) => {
      const tr = (ev.target as HTMLElement).closest<HTMLElement>('tr[data-month]');
      if (tr) selectMonth(monthAbs(tr.dataset.month!));
    });
  }

  // ------------------------------------------------------------------ controls

  function fillPeriodSelects(firstAbs: number, lastAbs: number) {
    const opts = (vals: [string, string][]) => vals.map(([v, t]) => `<option value="${v}">${t}</option>`).join('');
    const months = opts(MONTHS.map((m, i) => [String(i + 1).padStart(2, '0'), m]));
    const yearList: [string, string][] = [];
    for (let y = Math.floor(firstAbs / 12); y <= Math.floor(lastAbs / 12); y++) yearList.push([String(y), String(y)]);
    for (const s of [fromM, toM]) s.innerHTML = months;
    for (const s of [fromY, toY]) s.innerHTML = opts(yearList);
    for (const s of [fromM, fromY, toM, toY]) s.disabled = false;
  }

  function setPeriodSelects(from: string, to: string) {
    fromY.value = from.slice(0, 4); fromM.value = from.slice(5, 7);
    toY.value = to.slice(0, 4); toM.value = to.slice(5, 7);
  }

  function fillPresets(code: string) {
    const list = PRESETS.filter((p) => p.country === code || code === WORLD_CODE);
    presetSel.innerHTML = '<option value="">(none)</option>' +
      list.map((p) => `<option value="${p.id}">${escapeHtml(p.name)}</option>`).join('');
    presetSel.disabled = !list.length;
  }

  function syncControls(country: Country) {
    $('whole-label').textContent = country.code === WORLD_CODE ? 'All countries' : 'Whole country';
    const custom = state.area.kind !== 'country';
    modeRadios.forEach((r) => (r.checked = r.value === (custom ? 'custom' : 'country')));
    customEl.hidden = !custom;
    fillPresets(country.code);
    presetSel.value = state.area.kind === 'preset' ? state.area.id : '';
    const shape = custom ? resolveShape(state.area) : null;
    const bb = shape ? shapeBBox(shape) : country.bbox;
    const f = rectForm.elements as unknown as Record<'w' | 's' | 'e' | 'n', HTMLInputElement>;
    // For a polygon the inputs show its bounding box (Apply turns it into that rectangle).
    [f.w.value, f.s.value, f.e.value, f.n.value] = bb.map((v) => String(Math.round(v * 100) / 100));
    const notes: string[] = [];
    if (state.area.kind === 'preset') {
      const p = PRESETS.find((x) => x.id === (state.area as { id: string }).id);
      if (p) notes.push(escapeHtml(p.note));
    }
    if (shape?.kind === 'polygon' && state.area.kind === 'shape') {
      notes.push(`Polygon with ${shape.ring.length} points (drawn on the map).`);
    }
    if (shape && !bboxOverlap(shapeBBox(shape), country.bbox)) {
      notes.push(`<span class="warn">This area is outside ${escapeHtml(country.name)}: all values are 0.</span>`);
    }
    if (custom) notes.push('A 0.1° cell counts when its center is inside the area.');
    areaNote.innerHTML = notes.join(' ');
  }

  function writeHash() {
    history.replaceState(null, '', serializeHash(state));
  }

  function setState(next: Partial<ViewState>) {
    state = { ...state, ...next };
    if (state.area.kind !== 'country') lastCustom = state.area;
    writeHash();
    show();
  }

  function readPeriod(): { from: string; to: string } {
    let from = `${fromY.value}-${fromM.value}`;
    let to = `${toY.value}-${toM.value}`;
    if (from > to) [from, to] = [to, from];
    return { from, to };
  }

  function syncView(h: Harmonized, d: CountryData) {
    const raw = state.view === 'raw';
    viewBtns.forEach((b) => b.setAttribute('aria-pressed', String((b.dataset.view === 'raw') === raw)));
    $('calendar-unit').textContent = raw
      ? 'raw fire cell-days per month, each sensor on its own scale'
      : 'fire cell-days per month, VIIRS S-NPP scale';
    $('annual-unit').textContent = raw
      ? 'sum of raw monthly cell-days, no harmonization'
      : 'sum of monthly cell-days, ~80% interval for estimated years';
    const r = rawRatio(h, d.model);
    viewNote.textContent = raw
      ? `${r ? `VIIRS sees about ${r.toFixed(1)}× more cell-days than MODIS here (same months), so raw counts jump in 2012. ` : ''}` +
        'Other panels stay harmonized.'
      : 'Before 2012: MODIS put on the VIIRS scale by the model.';
  }

  // ------------------------------------------------------------------ flow

  async function show() {
    const country = countries.find((c) => c.code === state.code) ?? countries[0];
    state.code = country.code;
    select.value = country.code;
    const id = ++requestId;
    status.textContent = `Loading ${country.name}…`;
    try {
      const t0 = performance.now();
      const shape = resolveShape(state.area);
      areaMap?.show(country.code, country.bbox, shape); // move the map while the data loads
      const one = (dc: CountryData) => {
        const nc = monthCount(dc.cells.first_month, seriesEnd(dc.model));
        const hcc = harmonize(monthlyTotals(dc.cells, nc), dc.model);
        const hh = shape ? harmonizeArea(monthlyTotals(dc.cells, nc, keepFn(shape)), hcc, dc.model) : hcc;
        return { d: dc, hc: hcc, h: hh };
      };
      let d: CountryData, hc: Harmonized, h: Harmonized;
      let parts: { d: CountryData; hc: Harmonized; h: Harmonized }[] | undefined;
      if (country.code === WORLD_CODE) {
        // Every country harmonized with its own model, then summed.
        const codes = countries.filter((c) => c.code !== WORLD_CODE).map((c) => c.code);
        let done = 0;
        const all = await Promise.all(codes.map((c) => loadCountry(c).then((x) => {
          done++;
          if (id === requestId) status.textContent = `Loading ${country.name}… ${done} of ${codes.length}`;
          return x;
        })));
        if (id !== requestId) return;
        parts = all.map(one);
        const model = worldModel(all.map((x) => x.model));
        const c0 = all[0].cells;
        d = {
          code: WORLD_CODE, model, timing: all[0].timing,
          cells: { first_month: c0.first_month, cell_deg: c0.cell_deg, lat: [], lon: [], m: [], modis: [], viirs: [] },
        };
        hc = sumSeries(parts.map((p) => p.hc));
        h = shape ? sumSeries(parts.map((p) => p.h)) : hc;
      } else {
        d = await loadCountry(country.code);
        if (id !== requestId) return; // a newer selection won
        ({ hc, h } = one(d));
      }
      const n = monthCount(d.cells.first_month, seriesEnd(d.model));

      // Period: clamp to the data; full period is not written to the link.
      const firstAbs = monthAbs(d.cells.first_month);
      const lastAbs = firstAbs + n - 1;
      const clamp = (ym: string | undefined, dflt: number) =>
        ym ? Math.min(Math.max(monthAbs(ym), firstAbs), lastAbs) - firstAbs : dflt - firstAbs;
      let fromIdx = clamp(state.from, firstAbs);
      let toIdx = clamp(state.to, lastAbs);
      if (fromIdx > toIdx) [fromIdx, toIdx] = [toIdx, fromIdx];
      fillPeriodSelects(firstAbs, lastAbs);
      setPeriodSelects(monthStr(firstAbs + fromIdx), monthStr(firstAbs + toIdx));
      syncControls(country);

      current = { country, d, h, hc, fromIdx, toIdx, parts };
      // Month on the map: keep it when it is inside the period, else the last month of the period.
      if (selAbs === null || selAbs < firstAbs + fromIdx || selAbs > firstAbs + toIdx) selAbs = firstAbs + toIdx;
      const hv = state.view === 'raw' ? rawSplice(h, d.model) : h;
      syncView(h, d);
      areaMap?.show(country.code, country.bbox, shape);
      updateMapLayer();
      renderNow(country, d, h);
      renderAnomalies(h, fromIdx, toIdx);
      updateExportNote();
      await renderCalendar(country, d, hv, fromIdx, toIdx);
      if (id !== requestId) return;
      await renderAnnual(country, d, hv, fromIdx, toIdx);
      if (id !== requestId) return;
      await renderSeason();
      if (id !== requestId) return;
      await renderForecast();
      if (id !== requestId) return;
      status.textContent = '';
      console.info(`[seamless-fire] ${country.code}: first chart ${(performance.now() - t0).toFixed(0)} ms after select`);
    } catch (err) {
      if (id !== requestId) return;
      console.error(err);
      status.textContent = err instanceof AreaError
        ? err.message
        : `Could not load ${country.name}. Check the connection and try again.`;
    }
  }

  function applyHash() {
    const p = parseHash(location.hash);
    state = { code: p.code || 'PL', area: p.area, from: p.from, to: p.to, view: p.view };
    if (state.area.kind === 'preset') {
      const pr = PRESETS.find((x) => x.id === (state.area as { id: string }).id);
      if (pr && p.code && pr.country !== state.code && state.code !== WORLD_CODE) state.area = { kind: 'country' };
    }
    if (state.area.kind !== 'country') lastCustom = state.area;
    show().then(() => {
      if (p.error) status.textContent = `Part of the link was ignored: ${p.error}`;
      prefetchCountries();
    });
  }

  let prefetched = false;
  /** After the first view: load the other countries one by one while the browser is idle, so
   * switching country (and "All countries") does not wait for the network. Skipped on data saver. */
  function prefetchCountries() {
    if (prefetched) return;
    prefetched = true;
    const conn = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
    if (conn?.saveData) return;
    const idle = (f: () => void) =>
      'requestIdleCallback' in window ? requestIdleCallback(f, { timeout: 3000 }) : setTimeout(f, 1000);
    // smallest files first (country list order puts AU, the largest, near the front)
    const order = ['PL', 'PT', 'GR', 'ES', 'CL', 'CA', 'UA', 'AU'];
    const rank = (c: string) => (order.includes(c) ? order.indexOf(c) : order.length);
    const codes = countries.map((c) => c.code).filter((c) => c !== WORLD_CODE).sort((a, b) => rank(a) - rank(b));
    const next = () => {
      const code = codes.shift();
      if (!code) return;
      loadCountry(code).catch(() => {}).finally(() => idle(next));
    };
    idle(next);
  }

  // ------------------------------------------------------------------ map (loaded after the first chart)

  async function initMap() {
    const btnDraw = $<HTMLButtonElement>('draw');
    const btnFinish = $<HTMLButtonElement>('draw-finish');
    const btnUndo = $<HTMLButtonElement>('draw-undo');
    const btnCancel = $<HTMLButtonElement>('draw-cancel');
    const hint = $('draw-hint');
    btnDraw.disabled = true;
    try {
      const { AreaMap } = await import('../lib/map');
      areaMap = new AreaMap($('map'), {
        padding: mapPadding,
        onPolygon: (ring) => setState({ area: { kind: 'shape', shape: { kind: 'polygon', ring } } }),
        onDrawState: (drawing, points) => {
          btnDraw.hidden = drawing;
          btnFinish.hidden = btnUndo.hidden = btnCancel.hidden = !drawing;
          btnFinish.disabled = points < 3;
          btnUndo.disabled = points === 0;
          hint.textContent = drawing
            ? `Click to add points (${points}). Double-click or Finish to close the polygon.`
            : '';
        },
      });
      btnDraw.addEventListener('click', () => areaMap!.startDrawing());
      btnFinish.addEventListener('click', () => areaMap!.finish());
      btnUndo.addEventListener('click', () => areaMap!.undo());
      btnCancel.addEventListener('click', () => areaMap!.cancelDrawing());
      btnDraw.disabled = false;
      hint.textContent = '';
      const c = current?.country ?? countries.find((x) => x.code === state.code);
      if (c) {
        try {
          areaMap.show(c.code, c.bbox, resolveShape(state.area));
        } catch { /* invalid area in the link: show() reports it */ }
      }
      areaMap.ensureView();
      if (current) updateMapLayer();
    } catch (err) {
      console.error(err);
      $('map').hidden = true;
      btnDraw.hidden = true;
      hint.textContent = 'Map could not be loaded; use the rectangle inputs.';
    }
  }

  async function init() {
    plotly(); // start loading Plotly in parallel with the data
    try {
      countries = await fetchJson<Country[]>('countries.json');
      countries = [
        { code: WORLD_CODE, name: `All countries (${countries.length})`, bbox: unionBBox(countries.map((c) => c.bbox)) },
        ...countries,
      ];
    } catch {
      status.textContent = 'No data found. Run: python pipeline/build_data.py';
      return;
    }
    select.innerHTML = countries
      .map((c) => `<option value="${c.code}">${escapeHtml(c.name)}</option>`)
      .join('');
    select.disabled = false;

    select.addEventListener('change', () => {
      const code = select.value;
      const country = countries.find((c) => c.code === code)!;
      // Keep a drawn area only when it overlaps the new country; presets belong to one country.
      let area = state.area;
      if (area.kind === 'preset' && code !== WORLD_CODE &&
        PRESETS.find((p) => p.id === (area as { id: string }).id)?.country !== code) area = { kind: 'country' };
      const shape = area.kind === 'shape' ? area.shape : null;
      if (shape && !bboxOverlap(shapeBBox(shape), country.bbox)) area = { kind: 'country' };
      lastCustom = area.kind === 'country' ? null : area;
      setState({ code, area });
    });
    modeRadios.forEach((r) => r.addEventListener('change', () => {
      if (r.value === 'country') setState({ area: { kind: 'country' } });
      else if (lastCustom) setState({ area: lastCustom });
      else {
        // No custom area yet: start from the first preset of the country, or show the inputs.
        const p = PRESETS.find((x) => x.country === state.code);
        if (p) setState({ area: { kind: 'preset', id: p.id } });
        else { customEl.hidden = false; areaNote.textContent = 'Enter a rectangle and press Apply.'; }
      }
    }));
    presetSel.addEventListener('change', () => {
      if (presetSel.value) setState({ area: { kind: 'preset', id: presetSel.value } });
    });
    rectForm.addEventListener('submit', (ev) => {
      ev.preventDefault();
      const f = rectForm.elements as unknown as Record<'w' | 's' | 'e' | 'n', HTMLInputElement>;
      const v = [f.w, f.s, f.e, f.n].map((x) => (x.value.trim() === '' ? NaN : Number(x.value.replace(',', '.'))));
      try {
        setState({ area: { kind: 'shape', shape: { kind: 'rect', bbox: normalizeRect(v) } } });
      } catch (err) {
        areaNote.innerHTML = `<span class="warn">${escapeHtml(err instanceof Error ? err.message : String(err))}</span>`;
      }
    });
    viewBtns.forEach((b) => b.addEventListener('click', () => {
      const view = b.dataset.view === 'raw' ? 'raw' : undefined;
      if (view !== state.view) setState({ view });
    }));
    for (const s of [fromM, fromY, toM, toY]) s.addEventListener('change', () => setState(readPeriod()));
    $('full-period').addEventListener('click', () => setState({ from: undefined, to: undefined }));
    dlMonthly.addEventListener('click', () => {
      if (!current) return;
      const { d, country, h, fromIdx, toIdx } = current;
      const first = monthAbs(h.firstMonth);
      download(
        `seamless-fire_${country.code}_${areaSlug(state.area)}_${monthStr(first + fromIdx)}_${monthStr(first + toIdx)}_monthly.csv`,
        monthlyCsv(h, d.model, fromIdx, toIdx),
      );
    });
    dlHotspots.addEventListener('click', startHotspotExport);
    dlReport.addEventListener('click', () => void startReport());
    dlCancel.addEventListener('click', () => exportJob?.abort());
    window.addEventListener('hashchange', applyHash);
    initPanels();
    initMap();
    applyHash();
  }

  init();
</script>
