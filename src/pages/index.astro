---
import Base from '../layouts/Base.astro';
---

<Base title="Seamless Fire" app>
  <div class="app">
    <aside class="panel left" id="panel-left" aria-label="Controls">
      <div class="panel-head">
        <h1>Controls</h1>
        <button type="button" id="toggle-left" class="icon" aria-expanded="true" title="Hide controls">‹</button>
      </div>
      <div class="panel-body">
        <p class="lead">
          Fire activity since 2000 on one scale: MODIS and VIIRS hotspots harmonized, so years
          before and after 2012 compare directly.
        </p>

        <details open class="sec">
          <summary>Country and area</summary>
          <div class="row">
            <select id="country" disabled aria-label="Country"><option>Loading…</option></select>
          </div>
          <span id="status" class="status" role="status"></span>
          <fieldset class="row">
            <legend class="sr-only">Area</legend>
            <label class="radio"><input type="radio" name="mode" value="country" checked /> <span id="whole-label">Whole country</span></label>
            <label class="radio"><input type="radio" name="mode" value="custom" /> Custom area</label>
          </fieldset>
          <div id="custom" class="custom" hidden>
            <div class="row">
              <label for="preset">Example</label>
              <select id="preset"></select>
            </div>
            <form id="rect" class="rect" autocomplete="off">
              <span class="lbl">Rectangle (degrees)</span>
              <div class="rect-grid">
                <label>W <input name="w" inputmode="decimal" /></label>
                <label>S <input name="s" inputmode="decimal" /></label>
                <label>E <input name="e" inputmode="decimal" /></label>
                <label>N <input name="n" inputmode="decimal" /></label>
              </div>
              <button type="submit">Apply rectangle</button>
            </form>
            <p id="area-note" class="note"></p>
          </div>
          <div class="row map-tools">
            <button type="button" id="draw">Draw polygon on map</button>
            <button type="button" id="draw-finish" hidden>Finish</button>
            <button type="button" id="draw-undo" hidden>Undo point</button>
            <button type="button" id="draw-cancel" hidden>Cancel</button>
          </div>
          <p id="draw-hint" class="note"></p>
        </details>

        <details open class="sec">
          <summary>Period</summary>
          <div class="row period">
            <label><span>From</span><select id="from-m" class="small" aria-label="From month" disabled><option>…</option></select><select id="from-y" class="small" aria-label="From year" disabled><option>…</option></select></label>
            <label><span>To</span><select id="to-m" class="small" aria-label="To month" disabled><option>…</option></select><select id="to-y" class="small" aria-label="To year" disabled><option>…</option></select></label>
          </div>
          <button type="button" id="full-period">Full period</button>
        </details>

        <details open class="sec">
          <summary>Values</summary>
          <div class="view-toggle" role="group" aria-label="Calendar values">
            <button type="button" data-view="harmonized" aria-pressed="true">Harmonized</button>
            <button type="button" data-view="raw" aria-pressed="false" title="Raw counts: MODIS before 2012, then VIIRS">Raw</button>
          </div>
          <p id="view-note" class="note"></p>
        </details>

        <details open class="sec">
          <summary>Map layer</summary>
          <div class="row">
            <label class="radio"><input type="radio" name="mapmode" value="month" checked autocomplete="off" /> One month</label>
            <label class="radio"><input type="radio" name="mapmode" value="period" autocomplete="off" /> Whole period</label>
          </div>
          <div class="row month-step">
            <button type="button" id="map-prev" class="icon" title="Previous month">‹</button>
            <span id="map-month" class="map-month">—</span>
            <button type="button" id="map-next" class="icon" title="Next month">›</button>
          </div>
          <p class="note">Click a month in the calendar to show it on the map. Each cell gets its share of
            the harmonized value, so the cells of an area add up to its calendar value.</p>
        </details>

        <details class="sec">
          <summary>Download</summary>
          <div class="row">
            <button type="button" id="dl-monthly">Monthly series (CSV)</button>
            <button type="button" id="dl-hotspots">Hotspots (CSV)</button>
            <button type="button" id="dl-cancel" hidden>Cancel</button>
          </div>
          <span id="dl-status" class="status" role="status"></span>
          <p class="note" id="dl-note"></p>
        </details>
      </div>
    </aside>

    <section id="now" class="panel now" aria-live="polite">
      <div class="now-head"><h2>Now</h2><p class="now-month">Loading the latest month…</p></div>
      <div class="skel" aria-hidden="true"><span></span><span></span><span></span></div>
    </section>

    <div class="map-wrap">
      <div id="map" class="map" aria-label="Map of fire cells and the selected area"></div>
    </div>

    <section class="dock" id="dock" aria-label="Charts">
      <div class="dock-tabs" role="tablist">
        <button type="button" role="tab" data-tab="calendar" aria-selected="true">Calendar</button>
        <button type="button" role="tab" data-tab="annual" aria-selected="false">Per year</button>
        <button type="button" role="tab" data-tab="anomalies" aria-selected="false">Top anomalies</button>
        <button type="button" role="tab" data-tab="about" aria-selected="false">How to read it</button>
      </div>
      <div class="dock-body">
        <div class="tab" data-tab="calendar">
          <p class="unit"><span id="calendar-unit">fire cell-days per month, VIIRS S-NPP scale</span>. Click a month to map it.</p>
          <div id="calendar" class="calendar"></div>
          <p class="note" id="calendar-note"></p>
        </div>
        <div class="tab" data-tab="annual" hidden>
          <p class="unit"><span id="annual-unit">sum of monthly cell-days, ~80% interval for estimated years</span>.</p>
          <div id="annual" class="annual"></div>
          <p class="note" id="annual-note"></p>
        </div>
        <div class="tab" data-tab="anomalies" hidden>
          <p class="unit">Months most above their usual level, in the selected period. Click a row to map it.</p>
          <div id="anomalies"></div>
          <p class="note">
            × typical = (value + k) / (median + k), median of the same calendar month in the 10 years
            before. k is a small offset that scales with the area, so tiny counts do not explode.
          </p>
        </div>
        <div class="tab about" data-tab="about" hidden>
          <ul>
            <li>
              <b>Cell-day</b>: a 0.1° grid cell (about 11 km) with at least one vegetation fire detection on
              a given day. Industrial heat sources (FIRMS <code>type</code> 2) are removed.
            </li>
            <li>
              <b>From February 2012</b> the values are observed VIIRS S-NPP cell-days. <b>Before</b>, they are
              estimated from MODIS with a per-country model calibrated on 2012–2025
              (hover shows the ~80% interval).
            </li>
            <li>
              <b>Custom area</b>: a cell counts when its center is inside the area. Before 2012 the area gets
              its share of the country estimate (area MODIS / country MODIS). Small areas are much less
              certain than whole countries.
            </li>
            <li>
              <b>Map</b>: each cell shows its share of the harmonized value, by the same rule. Estimated
              months spread the country value over cells by their MODIS cell-days.
            </li>
            <li>
              Marked months have known sensor problems: early Terra data (Jan–Oct 2000), Aqua failure
              (Aug–Sep 2020), S-NPP outage (Jul–Aug 2022). Aug–Oct 2026 are preliminary (near real-time).
            </li>
            <li>
              Data: NASA FIRMS active fire products (MODIS Collection 6.1, VIIRS 375 m from S-NPP and
              NOAA-20). Base map: Sentinel-2 cloudless (EOX), OpenStreetMap. Code: Apache 2.0.
              <a href="method/">Method and validation</a>.
            </li>
          </ul>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  /* Grid layout, nothing floats over the map:
       controls | Now strip (map + charts width)
       controls | map | charts                     */
  .app {
    position: fixed;
    inset: var(--header-h) 0 0 0;
    display: grid;
    grid-template-columns: var(--left-w) minmax(0, 1fr) minmax(500px, 46%);
    grid-template-rows: auto minmax(0, 1fr);
    gap: 10px;
    padding: 10px;
    overflow: hidden;
  }
  .app:has(.left.collapsed) {
    grid-template-columns: 46px minmax(0, 1fr) minmax(500px, 46%);
  }
  .map-wrap {
    grid-row: 2;
    grid-column: 2;
    position: relative;
    min-height: 0;
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
  }
  .map {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: #0b1a2b;
  }
  .panel,
  .dock {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 8px;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
    min-width: 0;
    min-height: 0;
  }
  .left {
    grid-row: 1 / 3;
    grid-column: 1;
    display: flex;
    flex-direction: column;
    align-self: start;
    max-height: 100%;
  }
  .left.collapsed .panel-body,
  .left.collapsed h1 {
    display: none;
  }
  .left.collapsed .panel-head {
    padding: 0.45rem;
    justify-content: center;
  }
  .panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.45rem 0.6rem 0.45rem 0.9rem;
    background: var(--head);
    color: #fff;
    border-radius: 8px 8px 0 0;
  }
  .left.collapsed .panel-head {
    border-radius: 8px;
  }
  .panel-head h1 {
    font-size: 1.1rem;
    margin: 0;
  }
  .panel-body {
    overflow-y: auto;
    padding: 0.3rem 0.9rem 0.8rem;
  }
  .lead {
    color: var(--text);
    font-size: 0.9rem;
    line-height: 1.45;
    margin: 0.5rem 0 0.5rem;
  }
  .sec {
    border-top: 1px solid var(--line);
    padding: 0.5rem 0 0.3rem;
  }
  .sec summary {
    font-weight: 700;
    cursor: pointer;
    margin-bottom: 0.4rem;
    color: var(--head);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.7rem;
    align-items: center;
    margin: 0 0 0.5rem;
  }
  fieldset.row {
    border: 0;
    padding: 0;
  }
  .row select:not(.small) {
    width: 100%;
  }
  label[for],
  .lbl {
    font-weight: 600;
  }
  .radio {
    font-weight: 400;
  }
  .custom {
    border-left: 3px solid var(--line);
    padding-left: 0.6rem;
    margin-bottom: 0.6rem;
  }
  .rect-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.3rem 0.6rem;
    margin: 0.3rem 0 0.4rem;
  }
  .rect-grid label {
    display: flex;
    gap: 0.3rem;
    align-items: center;
  }
  .rect-grid input {
    font: inherit;
    width: 100%;
    min-width: 0;
    padding: 0.2rem 0.4rem;
    border: 1px solid var(--line);
    border-radius: 6px;
  }
  .period {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.35rem;
  }
  .period label {
    display: grid;
    grid-template-columns: 2.6rem 1fr 1fr;
    gap: 0.3rem;
    align-items: center;
    font-weight: 400;
  }
  .period select {
    width: 100%;
  }
  .view-toggle {
    display: grid;
    grid-template-columns: 1fr 1fr;
    width: 100%;
    border: 1px solid var(--line);
    border-radius: 6px;
    overflow: hidden;
  }
  .view-toggle button {
    border: 0;
    border-radius: 0;
  }
  .view-toggle button + button {
    border-left: 1px solid var(--line);
  }
  .view-toggle button[aria-pressed='true'] {
    background: var(--head);
    color: #fff;
  }
  .month-step {
    flex-wrap: nowrap;
  }
  .map-month {
    flex: 1;
    text-align: center;
    font-weight: 600;
    font-size: 0.92rem;
  }
  .now {
    grid-row: 1;
    grid-column: 2 / 4;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 2rem;
    padding: 0.6rem 1rem;
    border-left: 4px solid var(--head);
  }
  .now > .skel {
    flex: 1;
    grid-template-columns: repeat(3, 1fr);
    max-width: 40rem;
  }
  .dock {
    grid-row: 2;
    grid-column: 3;
    display: flex;
    flex-direction: column;
  }
  .dock-tabs {
    display: flex;
    gap: 0.2rem;
    align-items: center;
    padding: 0.3rem 0.4rem 0;
    border-bottom: 1px solid var(--line);
    overflow-x: auto;
  }
  .dock-tabs [role='tab'] {
    border: 0;
    border-bottom: 3px solid transparent;
    border-radius: 0;
    background: none;
    padding: 0.3rem 0.6rem;
    white-space: nowrap;
  }
  .dock-tabs [role='tab'][aria-selected='true'] {
    border-bottom-color: var(--accent);
    font-weight: 700;
  }
  .skel {
    display: grid;
    gap: 0.45rem;
    margin: 0.3rem 0 0.6rem;
  }
  .skel span {
    display: block;
    height: 0.9rem;
    border-radius: 4px;
    background: linear-gradient(90deg, #eceff3 25%, #f6f7f9 50%, #eceff3 75%);
    background-size: 200% 100%;
    animation: skel 1.4s linear infinite;
  }
  .skel span {
    height: 2rem;
  }
  @keyframes skel {
    to {
      background-position: -200% 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .skel span {
      animation: none;
    }
  }
  .dock-body {
    flex: 1;
    overflow-y: auto;
    padding: 0.3rem 0.9rem 0.6rem;
  }
  .dock-body .unit {
    color: var(--muted);
    font-size: 0.85rem;
    margin: 0.2rem 0;
  }
  .annual {
    width: 100%;
    min-height: 300px;
  }
  .about ul {
    margin: 0.4rem 0;
    padding-left: 1.2rem;
    max-width: 60rem;
  }
  .about li {
    margin: 0.3rem 0;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  /* Narrow screens: one column in normal page flow (controls, Now, map, charts). */
  @media (max-width: 1150px) {
    .app,
    .app:has(.left.collapsed) {
      position: static;
      display: flex;
      flex-direction: column;
      overflow: visible;
    }
    .map-wrap {
      height: 60vh;
    }
    .dock-body {
      overflow: visible;
    }
  }
</style>

<style is:global>
  select.small {
    min-width: 0;
  }
  button {
    font: inherit;
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--card);
    cursor: pointer;
  }
  button:hover {
    border-color: var(--muted);
  }
  button:disabled {
    opacity: 0.5;
    cursor: default;
  }
  table.anom {
    border-collapse: collapse;
    width: 100%;
    font-size: 0.92rem;
  }
  table.anom th,
  table.anom td {
    padding: 0.3rem 0.5rem;
    border-bottom: 1px solid var(--line);
    text-align: right;
  }
  table.anom th:nth-child(2),
  table.anom td:nth-child(2),
  table.anom td:last-child,
  table.anom th:last-child {
    text-align: left;
  }
  .table-wrap {
    overflow-x: auto;
  }
  .warn {
    color: var(--accent);
  }
  button.icon {
    padding: 0.1rem 0.55rem;
    line-height: 1.3;
  }
  .panel-head button.icon {
    background: transparent;
    color: #fff;
    border-color: rgba(255, 255, 255, 0.5);
  }
  table.anom tbody tr {
    cursor: pointer;
  }
  table.anom tbody tr:hover {
    background: #f1f3f5;
  }
  /* "Now" strip injected by renderNow(): one row of key figures above the map and charts. */
  section.now h2 {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0;
  }
  section.now .now-month {
    font-size: 1.05rem;
    font-weight: 700;
    margin: 0;
    line-height: 1.3;
  }
  section.now .now-month .flag {
    display: inline-block;
    margin: 0 0 0 0.3rem;
    padding: 0 0.4rem;
    border-radius: 4px;
    background: #fdecea;
    font-size: 0.75rem;
    font-weight: 600;
    vertical-align: 0.15em;
  }
  section.now .now-fig {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }
  section.now .now-fig b {
    font-size: 1.75rem;
    font-weight: 700;
  }
  section.now .now-fig span {
    font-size: 0.82rem;
    color: var(--muted);
  }
  section.now .now-fig.hi b {
    color: var(--hi);
  }
  section.now .now-fig.lo b {
    color: var(--lo);
  }
  section.now dl {
    display: flex;
    gap: 0.3rem 1.6rem;
    flex-wrap: wrap;
    margin: 0;
    padding-left: 1.6rem;
    border-left: 1px solid var(--line);
    font-size: 0.82rem;
  }
  section.now dl div {
    display: flex;
    flex-direction: column-reverse;
  }
  section.now dt {
    color: var(--muted);
  }
  section.now dd {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 700;
  }
  section.now .now-note {
    flex: 1 1 14rem;
    font-size: 0.78rem;
    margin: 0;
    text-align: right;
  }
  .map-legend {
    background: rgba(255, 255, 255, 0.93);
    border-radius: 6px;
    padding: 0.4rem 0.6rem 0.45rem;
    width: 250px;
    font: 12px/1.35 system-ui, sans-serif;
    color: #24292f;
    box-shadow: 0 1px 6px rgba(0, 0, 0, 0.3);
  }
  .map-legend .lg-title {
    font-weight: 700;
    font-size: 12.5px;
  }
  .map-legend .lg-bar {
    height: 10px;
    border-radius: 2px;
    margin: 0.3rem 0 0;
  }
  .map-legend .lg-ticks {
    position: relative;
    height: 15px;
    margin: 0 6px;
  }
  .map-legend .lg-ticks span {
    position: absolute;
    transform: translateX(-50%);
    font-size: 11px;
    color: #57606a;
  }
  .map-legend .lg-unit {
    color: #57606a;
  }
  .map-legend .lg-mode {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin-top: 0.2rem;
    color: #57606a;
    font-size: 11px;
  }
  .map-legend .lg-mode button {
    font: inherit;
    padding: 0.05rem 0.4rem;
    border: 1px solid #d0d7de;
    border-radius: 4px;
    background: #fff;
    color: #24292f;
    cursor: pointer;
  }
  .map-legend .lg-mode button[aria-pressed='true'] {
    background: #24292f;
    border-color: #24292f;
    color: #fff;
  }
  .map-legend .lg-cell {
    margin-top: 0.2rem;
    border-top: 1px solid #d0d7de;
    padding-top: 0.2rem;
  }
  .leaflet-container {
    font: 12px/1.4 system-ui, sans-serif;
  }
  /* the attribution is long; keep the legend above it */
  .leaflet-bottom.leaflet-left {
    bottom: 22px;
  }
  .leaflet-control-attribution {
    border-radius: 4px 0 0 0;
    font-size: 10px;
  }
  .map-legend[hidden] {
    display: none;
  }
  /* Country borders and labels of the EOX overlay: neutral grey instead of orange, so they do not
     compete with the fire colours. */
  .labels-overlay {
    filter: grayscale(1) brightness(1.15);
    opacity: 0.75;
  }
  @media (max-width: 860px) {
    .leaflet-bottom.leaflet-left {
      bottom: 48px;
    }
    .map-legend .lg-mode span,
    .map-legend .lg-cell {
      display: none;
    }
  }
</style>

<script>
  import { dataUrl, fetchJson, loadCountry, type Country, type CountryData } from '../lib/data';
  import {
    annualTotals,
    coverageSpan,
    harmonize,
    harmonizeArea,
    monthAbs,
    monthCount,
    monthlyTotals,
    monthStr,
    rawRatio,
    rawSplice,
    type Harmonized,
  } from '../lib/harmonize';
  import {
    AreaError,
    PRESETS,
    bboxOverlap,
    keepFn,
    normalizeRect,
    parseHash,
    resolveShape,
    serializeHash,
    shapeBBox,
    type AreaSpec,
    type ViewState,
  } from '../lib/geo';
  import { monthStats, topAnomalies } from '../lib/stats';
  import { exportHotspots, hotspotYears, monthlyCsv } from '../lib/csv';
  import { cellLayer } from '../lib/cellmap';
  import { WORLD_CODE, mergeLayers, sumAnnual, sumSeries, unionBBox, worldModel } from '../lib/world';

  const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  const MONTHS_LONG = [
    'January', 'February', 'March', 'April', 'May', 'June',
    'July', 'August', 'September', 'October', 'November', 'December',
  ];
  // Fixed map colour scales (log), shared by all countries. A cell has at most 31 cell-days in
  // a month; per-cell 99th percentiles are 6–15 per month and 4–19 per year (2012–2025, 8 countries).
  const MAP_SCALE = {
    month: { max: 31, unit: 'Cell-days in the month per 0.1° cell, log scale' },
    period: { max: 30, unit: 'Cell-days per year per 0.1° cell (period average), log scale' },
  };
  const FIRMS_URL = 'https://firms.modaps.eosdis.nasa.gov/download/';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const select = $<HTMLSelectElement>('country');
  const status = $('status');
  const nowEl = $('now');
  const calEl = $('calendar');
  const noteEl = $('calendar-note');
  const annualEl = $('annual');
  const annualNote = $('annual-note');
  const anomEl = $('anomalies');
  const customEl = $('custom');
  const presetSel = $<HTMLSelectElement>('preset');
  const rectForm = $<HTMLFormElement>('rect');
  const areaNote = $('area-note');
  const fromM = $<HTMLSelectElement>('from-m');
  const fromY = $<HTMLSelectElement>('from-y');
  const toM = $<HTMLSelectElement>('to-m');
  const toY = $<HTMLSelectElement>('to-y');
  const dlMonthly = $<HTMLButtonElement>('dl-monthly');
  const dlHotspots = $<HTMLButtonElement>('dl-hotspots');
  const dlCancel = $<HTMLButtonElement>('dl-cancel');
  const dlStatus = $('dl-status');
  const dlNote = $('dl-note');
  const viewBtns = [...document.querySelectorAll<HTMLButtonElement>('.view-toggle button')];
  const viewNote = $('view-note');
  const modeRadios = [...document.querySelectorAll<HTMLInputElement>('input[name=mode]')];

  let countries: Country[] = [];
  let requestId = 0;
  let state: ViewState = { code: 'PL', area: { kind: 'country' } };
  let lastCustom: AreaSpec | null = null; // restored when switching back to "Custom area"
  // h = series of the selected area (or the country); hc = country series (map layer shares).
  let current: {
    country: Country; d: CountryData; h: Harmonized; hc: Harmonized; fromIdx: number; toIdx: number;
    parts?: { d: CountryData; hc: Harmonized; h: Harmonized }[]; // "All countries": per-country results
  } | null = null;
  let mapMode: 'month' | 'period' = 'month';
  let selAbs: number | null = null; // month shown on the map (absolute month number)
  let exportJob: AbortController | null = null;
  let areaMap: import('../lib/map').AreaMap | null = null;
  let plotlyPromise: Promise<typeof import('plotly.js-dist-min')['default']> | null = null;

  function plotly() {
    plotlyPromise ??= import('plotly.js-dist-min').then((m) => m.default);
    return plotlyPromise;
  }

  const fmt = (v: number) =>
    v >= 100 ? Math.round(v).toLocaleString('en-US') : v >= 10 ? v.toFixed(0) : v.toFixed(1);
  const monthLabel = (ym: string) => {
    const [y, m] = ym.split('-').map(Number);
    return `${MONTHS_LONG[m - 1]} ${y}`;
  };
  const shortMonth = (ym: string) => {
    const [y, m] = ym.split('-').map(Number);
    return `${MONTHS[m - 1]} ${y}`;
  };

  function escapeHtml(s: string) {
    return s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  }

  function areaLabel(a: AreaSpec): string | null {
    if (a.kind === 'country') return null;
    if (a.kind === 'preset') return PRESETS.find((p) => p.id === a.id)?.name ?? a.id;
    return a.shape.kind === 'rect' ? 'custom rectangle' : 'custom polygon';
  }

  function areaSlug(a: AreaSpec): string {
    return a.kind === 'country' ? 'country' : a.kind === 'preset' ? a.id : a.shape.kind === 'rect' ? 'rectangle' : 'polygon';
  }

  // ------------------------------------------------------------------ "Now" panel

  function renderNow(country: Country, d: CountryData, h: Harmonized) {
    const idx = h.value.length - 1;
    const s = monthStats(h, idx);
    const calName = MONTHS_LONG[(monthAbs(s.month) % 12)];
    let compare: string;
    if (s.ratio === null) {
      compare = `<p class="note">Not enough history for a typical value.</p>`;
    } else {
      const r = s.ratio;
      const word = r >= 1.25 ? 'above' : r <= 0.8 ? 'below' : 'close to';
      const cls = r >= 1.25 ? 'hi' : r <= 0.8 ? 'lo' : 'mid';
      compare = `
        <div class="now-fig ${cls}"><b>${r >= 10 ? r.toFixed(0) : r.toFixed(1)}×</b>
          <span>typical, ${word} the usual ${calName}</span></div>
        <dl>
          <div><dt>Typical ${calName} (median ${s.refFrom}–${s.refTo})</dt><dd>${fmt(s.median!)}</dd></div>
          <div><dt>Usual range (P10–P90)</dt><dd>${fmt(s.p10!)} – ${fmt(s.p90!)}</dd></div>
          <div><dt>Rank among ${s.nAll} ${calName}s since 2000</dt>
          <dd>higher than ${Math.round(s.percentile)}%</dd></div>
        </dl>`;
    }
    const interval = h.estimated[idx]
      ? `, estimated (~80%: ${fmt(h.lo[idx])} – ${fmt(h.hi[idx])})`
      : '';
    const flags = [
      h.preliminary[idx] ? 'preliminary (near real-time)' : '',
      h.lowQuality[idx] ? 'known sensor problem' : '',
    ].filter(Boolean);
    const label = areaLabel(state.area);
    nowEl.innerHTML = `
      <div class="now-head">
        <h2>Now · ${escapeHtml(country.name)}${label ? `, ${escapeHtml(label)}` : ''}</h2>
        <p class="now-month">${monthLabel(s.month)}${flags.map((f) => `<span class="flag">${f}</span>`).join('')}</p>
      </div>
      <div class="now-fig"><b>${fmt(s.value)}</b><span>fire cell-days${interval}</span></div>
      ${compare}
      <p class="note now-note">Latest complete month in the data. VIIRS S-NPP scale, model
        ${escapeHtml(d.model.model)}.${h.area ? ' Custom area: higher uncertainty than for the whole country.' : ''}</p>`;
    nowEl.hidden = false;
  }

  // ------------------------------------------------------------------ calendar

  async function renderCalendar(country: Country, d: CountryData, h: Harmonized, fromIdx: number, toIdx: number) {
    const Plotly = await plotly();
    const first = monthAbs(h.firstMonth);
    const y0 = Math.floor((first + fromIdx) / 12);
    const y1 = Math.floor((first + toIdx) / 12);
    const years: number[] = [];
    for (let y = y0; y <= y1; y++) years.push(y);

    const z: (number | null)[][] = years.map(() => new Array(12).fill(null));
    const text: string[][] = years.map(() => new Array(12).fill(''));
    const lowX: number[] = [], lowY: number[] = [];
    const preX: number[] = [], preY: number[] = [];
    // Months outside a sensor's raw-file coverage show "no data", not 0.
    const [modisFrom, modisTo] = coverageSpan(d.model, ['Terra', 'Aqua']) ?? [-Infinity, Infinity];
    const [viirsFrom, viirsTo] = coverageSpan(d.model, ['SNPP']) ?? [-Infinity, Infinity];
    const raw = (v: number, a: number, from: number, to: number) => (a < from || a > to ? 'no data' : fmt(v));
    let max = 0;
    for (let i = fromIdx; i <= toIdx; i++) {
      const a = first + i;
      const r = Math.floor(a / 12) - y0;
      const c = a % 12;
      const v = h.value[i];
      max = Math.max(max, v);
      z[r][c] = Math.log10(1 + v);
      const lines = [
        `<b>${MONTHS[c]} ${years[r]}</b>`,
        h.raw
          ? `${a < monthAbs(d.model.viirs_first_month) ? 'Raw MODIS' : 'Raw VIIRS'}: <b>${fmt(v)}</b> cell-days`
          : `${h.estimated[i] ? 'Estimated' : 'Observed'}: <b>${fmt(v)}</b> cell-days`,
      ];
      if (h.estimated[i]) lines.push(`~80% interval: ${fmt(h.lo[i])} – ${fmt(h.hi[i])}`);
      lines.push(
        `Raw MODIS: ${raw(h.modis[i], a, modisFrom, modisTo)}, raw VIIRS: ${raw(h.viirs[i], a, viirsFrom, viirsTo)}`,
      );
      if (h.viirsDet && !h.estimated[i]) lines.push(`VIIRS detections: ${fmt(h.viirsDet[i])}`);
      if (h.terraOnly[i]) lines.push('Terra only (before Aqua), scaled up');
      if (h.lowQuality[i]) { lines.push('Known sensor problem'); lowX.push(c); lowY.push(years[r]); }
      if (h.preliminary[i]) { lines.push('Preliminary (near real-time)'); preX.push(c); preY.push(years[r]); }
      text[r][c] = lines.join('<br>');
    }

    // Colour range from the 2nd percentile up: large areas never get near 0, and a range starting
    // at 0 would paint every month in the same bright end of the scale.
    // Months with sensor problems (e.g. Terra-only 2000) are left out of the range.
    const shown: number[] = [];
    for (let i = fromIdx; i <= toIdx; i++) if (!h.lowQuality[i]) shown.push(h.value[i]);
    shown.sort((p, q) => p - q);
    const low = shown[Math.floor(shown.length * 0.02)] ?? 0;
    const zmin = low >= 10 ? Math.log10(1 + low) : 0;
    const inRange = (t: number) => t <= Math.max(max, 1) * 1.05 && Math.log10(1 + t) >= zmin - 1e-9;
    let ticks = [0, 1, 3, 10, 30, 100, 300, 1000, 3000, 10000, 30000, 100000].filter(inRange);
    if (ticks.length < 4) ticks = [1, 2, 5].flatMap((m) => [1, 10, 100, 1000, 10000, 100000].map((p) => m * p))
      .sort((p, q) => p - q).filter(inRange);
    const data: Partial<Plotly.Data>[] = [
      {
        type: 'heatmap',
        x: MONTHS.map((_, i) => i),
        y: years,
        z,
        text: text as unknown as string[],
        hovertemplate: '%{text}<extra></extra>',
        hoverongaps: false,
        colorscale: 'Cividis',
        zmin,
        zmax: Math.max(Math.log10(1 + Math.max(max, 1)), zmin + 0.1),
        xgap: 1,
        ygap: 1,
        showlegend: false,
        colorbar: {
          title: { text: 'cell-days', side: 'right' },
          tickvals: ticks.map((t) => Math.log10(1 + t)),
          ticktext: ticks.map(String),
          thickness: 12,
        },
      } as Partial<Plotly.Data>,
      {
        type: 'scatter', mode: 'markers', x: lowX, y: lowY, name: 'known sensor problem',
        hoverinfo: 'skip',
        marker: { symbol: 'x-thin', size: 9, line: { width: 2, color: '#e8432e' } },
      },
      {
        type: 'scatter', mode: 'markers', x: preX, y: preY, name: 'preliminary',
        hoverinfo: 'skip',
        marker: { symbol: 'circle-open', size: 10, line: { width: 2, color: '#f28e2b' } },
      },
      {
        type: 'scatter', mode: 'markers', x: [], y: [], name: 'on the map', hoverinfo: 'skip',
        marker: { symbol: 'square-open', size: 16, line: { width: 2.5, color: '#e8432e' } },
      },
    ];

    // Step line between estimated and observed months (VIIRS starts in Feb 2012).
    const vf = monthAbs(d.model.viirs_first_month);
    const vy = Math.floor(vf / 12);
    const vc = vf % 12;
    const path = vc === 0
      ? `M -0.5 ${vy - 0.5} L 11.5 ${vy - 0.5}`
      : `M -0.5 ${vy + 0.5} L ${vc - 0.5} ${vy + 0.5} L ${vc - 0.5} ${vy - 0.5} L 11.5 ${vy - 0.5}`;
    const showStep = vf > first + fromIdx && vf <= first + toIdx;
    const lastEst = vf - 1;
    const estLabel = `${MONTHS[first % 12]} ${Math.floor(first / 12)} – ${MONTHS[lastEst % 12]} ${Math.floor(lastEst / 12)}`;

    const narrow = calEl.clientWidth < 560;
    // Fit all years into the chart panel when it has room (rows 16–30 px), else let it scroll.
    const body = calEl.closest<HTMLElement>('.dock-body');
    const avail = body && body.clientHeight > 300 ? body.clientHeight - 80 : 0;
    const rowH = avail ? Math.min(30, Math.max(16, Math.floor((avail - 100) / years.length))) : 20;
    const layout: Partial<Plotly.Layout> = {
      height: Math.max(260, years.length * rowH + 100),
      margin: { l: 44, r: 10, t: 28, b: 40 },
      paper_bgcolor: 'rgba(0,0,0,0)',
      plot_bgcolor: 'rgba(0,0,0,0)',
      font: { family: 'system-ui, sans-serif', size: 12, color: '#24292f' },
      xaxis: {
        tickvals: MONTHS.map((_, i) => i),
        ticktext: narrow ? MONTHS.map((m) => m[0]) : MONTHS,
        side: 'top', range: [-0.5, 11.5], fixedrange: true, showgrid: false, zeroline: false,
      },
      yaxis: {
        range: [y1 + 0.5, y0 - 0.5], dtick: narrow && years.length > 12 ? 2 : 1, fixedrange: true, showgrid: false,
        zeroline: false,
      },
      shapes: showStep ? [{ type: 'path', path, line: { color: '#e8432e', width: 2.5 }, layer: 'above' }] : [],
      legend: { orientation: 'h', x: 0, y: -0.02, yanchor: 'top' },
      showlegend: true,
    };
    await Plotly.react(calEl, data as Plotly.Data[], layout, {
      responsive: true, displaylogo: false,
      modeBarButtonsToRemove: ['zoom2d', 'pan2d', 'select2d', 'lasso2d', 'zoomIn2d', 'zoomOut2d', 'autoScale2d', 'resetScale2d'],
      toImageButtonOptions: { filename: `seamless-fire-${country.code}-${areaSlug(state.area)}-calendar` },
    });
    markCalendar();
    const gd = calEl as unknown as {
      on: (ev: string, f: (e: { points?: { x: number; y: number }[] }) => void) => void; _sfClick?: boolean;
    };
    if (!gd._sfClick) {
      gd._sfClick = true;
      gd.on('plotly_click', (e) => {
        const pt = e.points?.[0];
        if (pt) selectMonth(Number(pt.y) * 12 + Number(pt.x));
      });
    }
    const parts = [];
    if (h.raw) {
      parts.push(showStep
        ? 'Raw counts. Above the red line: MODIS, below: VIIRS S-NPP. The sensors count differently, so the series jumps at the switch.'
        : 'Raw counts of one sensor only.');
    } else if (vf > first + fromIdx) {
      parts.push(showStep
        ? `Above the red line (<b>${estLabel}</b>): estimated from MODIS. Below: observed VIIRS.`
        : 'All shown months are estimated from MODIS.');
    } else parts.push('All shown months are observed VIIRS.');
    parts.push(zmin > 0
      ? `Color scale is logarithmic; months below ${fmt(low)} share the darkest colour.`
      : 'Color scale is logarithmic.');
    if (h.area && !h.raw) parts.push('Before 2012 the area gets its share of the country estimate (area MODIS / country MODIS).');
    noteEl.innerHTML = parts.join(' ');
  }

  // ------------------------------------------------------------------ annual chart

  async function renderAnnual(country: Country, d: CountryData, h: Harmonized, fromIdx: number, toIdx: number) {
    const Plotly = await plotly();
    // "All countries": annual totals (and intervals) per country, then summed.
    const parts = current?.parts;
    const t = parts && !h.raw
      ? sumAnnual(parts.map((p) => ({ h: p.h, model: p.d.model })), fromIdx, toIdx)
      : annualTotals(h, d.model, fromIdx, toIdx);
    const hasInterval = t.map((x) => x.hi > x.lo);
    const vy = Math.floor(monthAbs(d.model.viirs_first_month) / 12);
    // Raw: grey = MODIS years, blue = VIIRS years (2012 is VIIRS except January).
    const colors = t.map((x) => ((h.raw ? x.year < vy : x.estimated) ? '#7f8fa6' : '#00224e'));
    const hover = t.map((x) => {
      const kind = h.raw ? (x.year < vy ? 'Raw MODIS' : 'Raw VIIRS') : x.estimated ? 'Estimated' : 'Observed';
      const lines = [`<b>${x.year}</b>`, `${kind}: <b>${fmt(x.value)}</b> cell-days`];
      if (x.hi > x.lo) lines.push(`~80% interval: ${fmt(x.lo)} – ${fmt(x.hi)}`);
      if (x.partial) lines.push(`Partial year: ${x.months} month${x.months === 1 ? '' : 's'}`);
      return lines.join('<br>');
    });
    const data: Partial<Plotly.Data>[] = [
      {
        type: 'bar',
        x: t.map((x) => x.year),
        y: t.map((x) => x.value),
        text: hover,
        hovertemplate: '%{text}<extra></extra>',
        textposition: 'none',
        marker: {
          color: colors,
          pattern: { shape: t.map((x) => (x.partial ? '/' : '')), fgcolor: '#ffffff', size: 6 },
        },
        error_y: {
          type: 'data', symmetric: false,
          array: t.map((x, i) => (hasInterval[i] ? x.hi - x.value : 0)),
          arrayminus: t.map((x, i) => (hasInterval[i] ? x.value - x.lo : 0)),
          color: '#e8432e', thickness: 1.5, width: 3,
        },
      } as Partial<Plotly.Data>,
    ];
    const layout: Partial<Plotly.Layout> = {
      height: 320,
      margin: { l: 60, r: 10, t: 10, b: 40 },
      paper_bgcolor: 'rgba(0,0,0,0)',
      plot_bgcolor: 'rgba(0,0,0,0)',
      font: { family: 'system-ui, sans-serif', size: 12, color: '#24292f' },
      xaxis: { fixedrange: true, dtick: t.length > 14 ? 2 : 1 },
      yaxis: { fixedrange: true, title: { text: 'cell-days' }, rangemode: 'tozero', gridcolor: '#e5e8ec' },
      bargap: 0.15,
      showlegend: false,
    };
    await Plotly.react(annualEl, data as Plotly.Data[], layout, {
      responsive: true, displaylogo: false,
      modeBarButtonsToRemove: ['zoom2d', 'pan2d', 'select2d', 'lasso2d', 'zoomIn2d', 'zoomOut2d', 'autoScale2d', 'resetScale2d'],
      toImageButtonOptions: { filename: `seamless-fire-${country.code}-${areaSlug(state.area)}-annual` },
    });
    const partial = t.filter((x) => x.partial).map((x) => x.year);
    annualNote.innerHTML =
      (h.raw
        ? 'Raw counts. Grey: MODIS, dark blue: VIIRS S-NPP (2012 includes raw MODIS for January). '
        : 'Grey: estimated from MODIS, dark blue: observed VIIRS (2012 mixes one estimated month). ') +
      (partial.length ? `Hatched: partial year (${partial.join(', ')}), not comparable with full years.` : '');
  }

  // ------------------------------------------------------------------ anomalies

  function renderAnomalies(h: Harmonized, fromIdx: number, toIdx: number) {
    const top = topAnomalies(h, fromIdx, toIdx, 10);
    if (!top.length) {
      anomEl.innerHTML = '<p class="note">Not enough history in the selected period.</p>';
      return;
    }
    const rows = top.map((a, i) => {
      const flags = [
        a.estimated ? 'estimated' : '',
        a.preliminary ? 'preliminary' : '',
        a.lowQuality ? 'sensor problem' : '',
      ].filter(Boolean).join(', ');
      const r = a.ratio!;
      return `<tr data-month="${a.month}" title="Show on the map"><td>${i + 1}</td><td>${shortMonth(a.month)}</td><td>${fmt(a.value)}</td>
        <td><b>${r >= 10 ? r.toFixed(0) : r.toFixed(1)}×</b></td><td>${fmt(a.median!)}</td>
        <td>${Math.round(a.percentile)}%</td><td>${flags}</td></tr>`;
    });
    anomEl.innerHTML = `<div class="table-wrap"><table class="anom">
      <thead><tr><th>#</th><th>Month</th><th>Cell-days</th><th>× typical</th><th>Typical</th>
      <th>Percentile</th><th>Notes</th></tr></thead><tbody>${rows.join('')}</tbody></table></div>`;
  }

  // ------------------------------------------------------------------ export

  function download(name: string, text: string) {
    const url = URL.createObjectURL(new Blob([text], { type: 'text/csv;charset=utf-8' }));
    const a = document.createElement('a');
    a.href = url;
    a.download = name;
    document.body.append(a);
    a.click();
    a.remove();
    setTimeout(() => URL.revokeObjectURL(url), 1000);
  }

  function updateExportNote() {
    if (!current) return;
    const { d, country } = current;
    if (country.code === WORLD_CODE) {
      dlHotspots.disabled = true;
      dlNote.textContent = 'Hotspot files are per country: choose one country to download them.';
      return;
    }
    if (!d.model.hotspots) {
      dlHotspots.disabled = true;
      dlNote.innerHTML = `Hotspot files for ${escapeHtml(country.name)} are too large for this site. ` +
        `Download them from <a href="${FIRMS_URL}" target="_blank" rel="noopener">NASA FIRMS</a>.`;
      return;
    }
    dlHotspots.disabled = !!exportJob;
    dlNote.textContent =
      'Hotspots are filtered by their own coordinates, the series by 0.1° cell centers, so counts can differ ' +
      'slightly at the area edge. Hotspots are vegetation fires only (industrial sources removed); ' +
      '2026 has VIIRS only.';
  }

  async function startHotspotExport() {
    if (!current || exportJob) return;
    // Snapshot of the state at start: later changes on the page do not affect this file.
    const { d, country, h, fromIdx, toIdx } = current;
    const first = monthAbs(h.firstMonth);
    const from = monthStr(first + fromIdx);
    const to = monthStr(first + toIdx);
    const shape = resolveShape(state.area);
    const keep = shape ? keepFn(shape) : null;
    const years = hotspotYears(d.model, from, to);
    const name = `seamless-fire_${country.code}_${areaSlug(state.area)}_${from}_${to}_hotspots.csv`;
    const job = new AbortController();
    exportJob = job;
    dlHotspots.disabled = true;
    dlCancel.hidden = false;
    dlStatus.textContent = `Hotspots: year 0 of ${years.length}…`;
    try {
      const res = await exportHotspots({
        code: country.code, years, keep, from, to, signal: job.signal,
        fetchText: async (path, signal) => {
          const r = await fetch(dataUrl(path), { signal });
          if (!r.ok) throw new Error(`${path}: HTTP ${r.status}`);
          return r.text();
        },
        onProgress: (done, total, rows) => {
          dlStatus.textContent = `Hotspots: year ${done} of ${total}, ${rows.toLocaleString('en-US')} rows…`;
        },
      });
      download(name, res.csv);
      dlStatus.textContent = `Saved ${res.rows.toLocaleString('en-US')} hotspots.`;
    } catch (err) {
      if (job.signal.aborted) dlStatus.textContent = 'Hotspot download cancelled, no file saved.';
      else {
        console.error(err);
        dlStatus.textContent = 'Hotspot download failed, no file saved. Check the connection and try again.';
      }
    } finally {
      exportJob = null;
      dlCancel.hidden = true;
      updateExportNote();
    }
  }

  // ------------------------------------------------------------------ map layer

  /** Fire cells for the selected month (or the whole period) and the calendar marker. */
  function updateMapLayer() {
    if (!current || selAbs === null) return;
    const label = $('map-month');
    const { d, hc, fromIdx, toIdx } = current;
    const first = monthAbs(hc.firstMonth);
    const i = selAbs - first;
    let title: string;
    if (mapMode === 'month') {
      const kind = hc.estimated[i] ? 'estimated from MODIS' : hc.preliminary[i] ? 'VIIRS, preliminary' : 'observed VIIRS';
      title = `${monthLabel(monthStr(selAbs))} · ${kind}`;
      label.textContent = monthLabel(monthStr(selAbs));
    } else {
      title = `${shortMonth(monthStr(first + fromIdx))} – ${shortMonth(monthStr(first + toIdx))} · average per year`;
      label.textContent = 'Whole period';
    }
    $<HTMLButtonElement>('map-prev').disabled = mapMode !== 'month' || i <= fromIdx;
    $<HTMLButtonElement>('map-next').disabled = mapMode !== 'month' || i >= toIdx;
    markCalendar();
    if (!areaMap) return;
    // "All countries": each country's cells with its own shares, merged.
    const layerFor = (a: number, b: number) => current!.parts
      ? mergeLayers(current!.parts.map((p) => cellLayer(p.d.cells, p.hc, a, b)))
      : cellLayer(d.cells, hc, a, b);
    if (mapMode === 'month') {
      areaMap.setCells(layerFor(i, i), title, MAP_SCALE.month);
    } else {
      // Whole period: average per year, so the colour scale does not depend on the period length.
      const layer = layerFor(fromIdx, toIdx);
      const perYear = 12 / layer.months;
      for (let j = 0; j < layer.value.length; j++) layer.value[j] *= perYear;
      layer.max *= perYear;
      layer.total *= perYear;
      areaMap.setCells(layer, title, MAP_SCALE.period);
    }
  }

  /** Red square on the calendar month shown on the map (trace 3). */
  function markCalendar() {
    const gd = calEl as unknown as { data?: unknown[] };
    if (!gd.data || gd.data.length < 4 || selAbs === null || !plotlyPromise) return;
    const on = mapMode === 'month';
    const x = on ? [selAbs % 12] : [];
    const y = on ? [Math.floor(selAbs / 12)] : [];
    plotlyPromise.then((Plotly) => Plotly.restyle(calEl, { x: [x], y: [y] } as unknown as Plotly.Data, [3]));
  }

  function selectMonth(abs: number) {
    if (!current) return;
    const first = monthAbs(current.h.firstMonth);
    selAbs = Math.min(Math.max(abs, first + current.fromIdx), first + current.toIdx);
    mapMode = 'month';
    document.querySelectorAll<HTMLInputElement>('input[name=mapmode]').forEach((r) => (r.checked = r.value === 'month'));
    updateMapLayer();
  }

  // ------------------------------------------------------------------ panels

  function mapPadding(): { topLeft: [number, number]; bottomRight: [number, number] } {
    // nothing floats over the map; leave room for the legend in the bottom-left corner
    return { topLeft: [12, 12], bottomRight: [12, 24] };
  }

  /** Re-render the calendar so its rows fit the new panel height. */
  function rerenderCalendar() {
    if (!current) return;
    const { country, d, h, fromIdx, toIdx } = current;
    renderCalendar(country, d, state.view === 'raw' ? rawSplice(h, d.model) : h, fromIdx, toIdx);
  }

  function resizeCharts() {
    if (!plotlyPromise) return;
    plotlyPromise.then((Plotly) => {
      for (const el of [calEl, annualEl]) {
        if (el.offsetParent && (el as unknown as { data?: unknown }).data) Plotly.Plots.resize(el);
      }
    });
    areaMap?.resize();
  }

  function initPanels() {
    const tabs = [...document.querySelectorAll<HTMLButtonElement>('.dock-tabs [role=tab]')];
    const bodies = [...document.querySelectorAll<HTMLElement>('.dock-body .tab')];
    tabs.forEach((t) => t.addEventListener('click', () => {
      tabs.forEach((x) => x.setAttribute('aria-selected', String(x === t)));
      bodies.forEach((b) => (b.hidden = b.dataset.tab !== t.dataset.tab));
      resizeCharts();
    }));
    const left = $('panel-left');
    $('toggle-left').addEventListener('click', () => {
      const closed = left.classList.toggle('collapsed');
      $('toggle-left').textContent = closed ? '›' : '‹';
      $('toggle-left').title = closed ? 'Show controls' : 'Hide controls';
      $('toggle-left').setAttribute('aria-expanded', String(!closed));
      resizeCharts();
    });
    let resizeTimer = 0;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(rerenderCalendar, 200);
    });
    // Browsers may restore radio states on reload; the map mode always starts at "One month".
    document.querySelectorAll<HTMLInputElement>('input[name=mapmode]').forEach((r) => (r.checked = r.value === mapMode));
    document.querySelectorAll<HTMLInputElement>('input[name=mapmode]').forEach((r) => r.addEventListener('change', () => {
      mapMode = r.value as 'month' | 'period';
      updateMapLayer();
    }));
    $('map-prev').addEventListener('click', () => selAbs !== null && selectMonth(selAbs - 1));
    $('map-next').addEventListener('click', () => selAbs !== null && selectMonth(selAbs + 1));
    anomEl.addEventListener('click', (ev) => {
      const tr = (ev.target as HTMLElement).closest<HTMLElement>('tr[data-month]');
      if (tr) selectMonth(monthAbs(tr.dataset.month!));
    });
  }

  // ------------------------------------------------------------------ controls

  function fillPeriodSelects(firstAbs: number, lastAbs: number) {
    const opts = (vals: [string, string][]) => vals.map(([v, t]) => `<option value="${v}">${t}</option>`).join('');
    const months = opts(MONTHS.map((m, i) => [String(i + 1).padStart(2, '0'), m]));
    const yearList: [string, string][] = [];
    for (let y = Math.floor(firstAbs / 12); y <= Math.floor(lastAbs / 12); y++) yearList.push([String(y), String(y)]);
    for (const s of [fromM, toM]) s.innerHTML = months;
    for (const s of [fromY, toY]) s.innerHTML = opts(yearList);
    for (const s of [fromM, fromY, toM, toY]) s.disabled = false;
  }

  function setPeriodSelects(from: string, to: string) {
    fromY.value = from.slice(0, 4); fromM.value = from.slice(5, 7);
    toY.value = to.slice(0, 4); toM.value = to.slice(5, 7);
  }

  function fillPresets(code: string) {
    const list = PRESETS.filter((p) => p.country === code || code === WORLD_CODE);
    presetSel.innerHTML = '<option value="">(none)</option>' +
      list.map((p) => `<option value="${p.id}">${escapeHtml(p.name)}</option>`).join('');
    presetSel.disabled = !list.length;
  }

  function syncControls(country: Country) {
    $('whole-label').textContent = country.code === WORLD_CODE ? 'All countries' : 'Whole country';
    const custom = state.area.kind !== 'country';
    modeRadios.forEach((r) => (r.checked = r.value === (custom ? 'custom' : 'country')));
    customEl.hidden = !custom;
    fillPresets(country.code);
    presetSel.value = state.area.kind === 'preset' ? state.area.id : '';
    const shape = custom ? resolveShape(state.area) : null;
    const bb = shape ? shapeBBox(shape) : country.bbox;
    const f = rectForm.elements as unknown as Record<'w' | 's' | 'e' | 'n', HTMLInputElement>;
    // For a polygon the inputs show its bounding box (Apply turns it into that rectangle).
    [f.w.value, f.s.value, f.e.value, f.n.value] = bb.map((v) => String(Math.round(v * 100) / 100));
    const notes: string[] = [];
    if (state.area.kind === 'preset') {
      const p = PRESETS.find((x) => x.id === (state.area as { id: string }).id);
      if (p) notes.push(escapeHtml(p.note));
    }
    if (shape?.kind === 'polygon' && state.area.kind === 'shape') {
      notes.push(`Polygon with ${shape.ring.length} points (drawn on the map).`);
    }
    if (shape && !bboxOverlap(shapeBBox(shape), country.bbox)) {
      notes.push(`<span class="warn">This area is outside ${escapeHtml(country.name)}: all values are 0.</span>`);
    }
    if (custom) notes.push('A 0.1° cell counts when its center is inside the area.');
    areaNote.innerHTML = notes.join(' ');
  }

  function writeHash() {
    history.replaceState(null, '', serializeHash(state));
  }

  function setState(next: Partial<ViewState>) {
    state = { ...state, ...next };
    if (state.area.kind !== 'country') lastCustom = state.area;
    writeHash();
    show();
  }

  function readPeriod(): { from: string; to: string } {
    let from = `${fromY.value}-${fromM.value}`;
    let to = `${toY.value}-${toM.value}`;
    if (from > to) [from, to] = [to, from];
    return { from, to };
  }

  function syncView(h: Harmonized, d: CountryData) {
    const raw = state.view === 'raw';
    viewBtns.forEach((b) => b.setAttribute('aria-pressed', String((b.dataset.view === 'raw') === raw)));
    $('calendar-unit').textContent = raw
      ? 'raw fire cell-days per month, each sensor on its own scale'
      : 'fire cell-days per month, VIIRS S-NPP scale';
    $('annual-unit').textContent = raw
      ? 'sum of raw monthly cell-days, no harmonization'
      : 'sum of monthly cell-days, ~80% interval for estimated years';
    const r = rawRatio(h, d.model);
    viewNote.textContent = raw
      ? `${r ? `VIIRS sees about ${r.toFixed(1)}× more cell-days than MODIS here (same months), so raw counts jump in 2012. ` : ''}` +
        'Other panels stay harmonized.'
      : 'Before 2012: MODIS put on the VIIRS scale by the model.';
  }

  // ------------------------------------------------------------------ flow

  async function show() {
    const country = countries.find((c) => c.code === state.code) ?? countries[0];
    state.code = country.code;
    select.value = country.code;
    const id = ++requestId;
    status.textContent = `Loading ${country.name}…`;
    try {
      const t0 = performance.now();
      const shape = resolveShape(state.area);
      areaMap?.show(country.code, country.bbox, shape); // move the map while the data loads
      const one = (dc: CountryData) => {
        const nc = monthCount(dc.cells.first_month, dc.model.last_complete_month);
        const hcc = harmonize(monthlyTotals(dc.cells, nc), dc.model);
        const hh = shape ? harmonizeArea(monthlyTotals(dc.cells, nc, keepFn(shape)), hcc, dc.model) : hcc;
        return { d: dc, hc: hcc, h: hh };
      };
      let d: CountryData, hc: Harmonized, h: Harmonized;
      let parts: { d: CountryData; hc: Harmonized; h: Harmonized }[] | undefined;
      if (country.code === WORLD_CODE) {
        // Every country harmonized with its own model, then summed.
        const codes = countries.filter((c) => c.code !== WORLD_CODE).map((c) => c.code);
        let done = 0;
        const all = await Promise.all(codes.map((c) => loadCountry(c).then((x) => {
          done++;
          if (id === requestId) status.textContent = `Loading ${country.name}… ${done} of ${codes.length}`;
          return x;
        })));
        if (id !== requestId) return;
        parts = all.map(one);
        const model = worldModel(all.map((x) => x.model));
        const c0 = all[0].cells;
        d = {
          code: WORLD_CODE, model, timing: all[0].timing,
          cells: { first_month: c0.first_month, cell_deg: c0.cell_deg, lat: [], lon: [], m: [], modis: [], viirs: [] },
        };
        hc = sumSeries(parts.map((p) => p.hc));
        h = shape ? sumSeries(parts.map((p) => p.h)) : hc;
      } else {
        d = await loadCountry(country.code);
        if (id !== requestId) return; // a newer selection won
        ({ hc, h } = one(d));
      }
      const n = monthCount(d.cells.first_month, d.model.last_complete_month);

      // Period: clamp to the data; full period is not written to the link.
      const firstAbs = monthAbs(d.cells.first_month);
      const lastAbs = firstAbs + n - 1;
      const clamp = (ym: string | undefined, dflt: number) =>
        ym ? Math.min(Math.max(monthAbs(ym), firstAbs), lastAbs) - firstAbs : dflt - firstAbs;
      let fromIdx = clamp(state.from, firstAbs);
      let toIdx = clamp(state.to, lastAbs);
      if (fromIdx > toIdx) [fromIdx, toIdx] = [toIdx, fromIdx];
      fillPeriodSelects(firstAbs, lastAbs);
      setPeriodSelects(monthStr(firstAbs + fromIdx), monthStr(firstAbs + toIdx));
      syncControls(country);

      current = { country, d, h, hc, fromIdx, toIdx, parts };
      // Month on the map: keep it when it is inside the period, else the last month of the period.
      if (selAbs === null || selAbs < firstAbs + fromIdx || selAbs > firstAbs + toIdx) selAbs = firstAbs + toIdx;
      const hv = state.view === 'raw' ? rawSplice(h, d.model) : h;
      syncView(h, d);
      areaMap?.show(country.code, country.bbox, shape);
      updateMapLayer();
      renderNow(country, d, h);
      renderAnomalies(h, fromIdx, toIdx);
      updateExportNote();
      await renderCalendar(country, d, hv, fromIdx, toIdx);
      if (id !== requestId) return;
      await renderAnnual(country, d, hv, fromIdx, toIdx);
      if (id !== requestId) return;
      status.textContent = '';
      console.info(`[seamless-fire] ${country.code}: first chart ${(performance.now() - t0).toFixed(0)} ms after select`);
    } catch (err) {
      if (id !== requestId) return;
      console.error(err);
      status.textContent = err instanceof AreaError
        ? err.message
        : `Could not load ${country.name}. Check the connection and try again.`;
    }
  }

  function applyHash() {
    const p = parseHash(location.hash);
    state = { code: p.code || 'PL', area: p.area, from: p.from, to: p.to, view: p.view };
    if (state.area.kind === 'preset') {
      const pr = PRESETS.find((x) => x.id === (state.area as { id: string }).id);
      if (pr && p.code && pr.country !== state.code && state.code !== WORLD_CODE) state.area = { kind: 'country' };
    }
    if (state.area.kind !== 'country') lastCustom = state.area;
    show().then(() => {
      if (p.error) status.textContent = `Part of the link was ignored: ${p.error}`;
      prefetchCountries();
    });
  }

  let prefetched = false;
  /** After the first view: load the other countries one by one while the browser is idle, so
   * switching country (and "All countries") does not wait for the network. Skipped on data saver. */
  function prefetchCountries() {
    if (prefetched) return;
    prefetched = true;
    const conn = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
    if (conn?.saveData) return;
    const idle = (f: () => void) =>
      'requestIdleCallback' in window ? requestIdleCallback(f, { timeout: 3000 }) : setTimeout(f, 1000);
    // smallest files first (country list order puts AU, the largest, near the front)
    const order = ['PL', 'PT', 'GR', 'ES', 'CL', 'CA', 'UA', 'AU'];
    const rank = (c: string) => (order.includes(c) ? order.indexOf(c) : order.length);
    const codes = countries.map((c) => c.code).filter((c) => c !== WORLD_CODE).sort((a, b) => rank(a) - rank(b));
    const next = () => {
      const code = codes.shift();
      if (!code) return;
      loadCountry(code).catch(() => {}).finally(() => idle(next));
    };
    idle(next);
  }

  // ------------------------------------------------------------------ map (loaded after the first chart)

  async function initMap() {
    const btnDraw = $<HTMLButtonElement>('draw');
    const btnFinish = $<HTMLButtonElement>('draw-finish');
    const btnUndo = $<HTMLButtonElement>('draw-undo');
    const btnCancel = $<HTMLButtonElement>('draw-cancel');
    const hint = $('draw-hint');
    btnDraw.disabled = true;
    try {
      const { AreaMap } = await import('../lib/map');
      areaMap = new AreaMap($('map'), {
        padding: mapPadding,
        onPolygon: (ring) => setState({ area: { kind: 'shape', shape: { kind: 'polygon', ring } } }),
        onDrawState: (drawing, points) => {
          btnDraw.hidden = drawing;
          btnFinish.hidden = btnUndo.hidden = btnCancel.hidden = !drawing;
          btnFinish.disabled = points < 3;
          btnUndo.disabled = points === 0;
          hint.textContent = drawing
            ? `Click to add points (${points}). Double-click or Finish to close the polygon.`
            : 'Or pick an example / enter a rectangle.';
        },
      });
      btnDraw.addEventListener('click', () => areaMap!.startDrawing());
      btnFinish.addEventListener('click', () => areaMap!.finish());
      btnUndo.addEventListener('click', () => areaMap!.undo());
      btnCancel.addEventListener('click', () => areaMap!.cancelDrawing());
      btnDraw.disabled = false;
      hint.textContent = 'Or pick an example / enter a rectangle.';
      const c = current?.country ?? countries.find((x) => x.code === state.code);
      if (c) {
        try {
          areaMap.show(c.code, c.bbox, resolveShape(state.area));
        } catch { /* invalid area in the link: show() reports it */ }
      }
      areaMap.ensureView();
      if (current) updateMapLayer();
    } catch (err) {
      console.error(err);
      $('map').hidden = true;
      btnDraw.hidden = true;
      hint.textContent = 'Map could not be loaded; use the rectangle inputs.';
    }
  }

  async function init() {
    plotly(); // start loading Plotly in parallel with the data
    try {
      countries = await fetchJson<Country[]>('countries.json');
      countries = [
        { code: WORLD_CODE, name: `All countries (${countries.length})`, bbox: unionBBox(countries.map((c) => c.bbox)) },
        ...countries,
      ];
    } catch {
      status.textContent = 'No data found. Run: python pipeline/build_data.py';
      return;
    }
    select.innerHTML = countries
      .map((c) => `<option value="${c.code}">${escapeHtml(c.name)}</option>`)
      .join('');
    select.disabled = false;

    select.addEventListener('change', () => {
      const code = select.value;
      const country = countries.find((c) => c.code === code)!;
      // Keep a drawn area only when it overlaps the new country; presets belong to one country.
      let area = state.area;
      if (area.kind === 'preset' && code !== WORLD_CODE &&
        PRESETS.find((p) => p.id === (area as { id: string }).id)?.country !== code) area = { kind: 'country' };
      const shape = area.kind === 'shape' ? area.shape : null;
      if (shape && !bboxOverlap(shapeBBox(shape), country.bbox)) area = { kind: 'country' };
      lastCustom = area.kind === 'country' ? null : area;
      setState({ code, area });
    });
    modeRadios.forEach((r) => r.addEventListener('change', () => {
      if (r.value === 'country') setState({ area: { kind: 'country' } });
      else if (lastCustom) setState({ area: lastCustom });
      else {
        // No custom area yet: start from the first preset of the country, or show the inputs.
        const p = PRESETS.find((x) => x.country === state.code);
        if (p) setState({ area: { kind: 'preset', id: p.id } });
        else { customEl.hidden = false; areaNote.textContent = 'Enter a rectangle and press Apply.'; }
      }
    }));
    presetSel.addEventListener('change', () => {
      if (presetSel.value) setState({ area: { kind: 'preset', id: presetSel.value } });
    });
    rectForm.addEventListener('submit', (ev) => {
      ev.preventDefault();
      const f = rectForm.elements as unknown as Record<'w' | 's' | 'e' | 'n', HTMLInputElement>;
      const v = [f.w, f.s, f.e, f.n].map((x) => (x.value.trim() === '' ? NaN : Number(x.value.replace(',', '.'))));
      try {
        setState({ area: { kind: 'shape', shape: { kind: 'rect', bbox: normalizeRect(v) } } });
      } catch (err) {
        areaNote.innerHTML = `<span class="warn">${escapeHtml(err instanceof Error ? err.message : String(err))}</span>`;
      }
    });
    viewBtns.forEach((b) => b.addEventListener('click', () => {
      const view = b.dataset.view === 'raw' ? 'raw' : undefined;
      if (view !== state.view) setState({ view });
    }));
    for (const s of [fromM, fromY, toM, toY]) s.addEventListener('change', () => setState(readPeriod()));
    $('full-period').addEventListener('click', () => setState({ from: undefined, to: undefined }));
    dlMonthly.addEventListener('click', () => {
      if (!current) return;
      const { d, country, h, fromIdx, toIdx } = current;
      const first = monthAbs(h.firstMonth);
      download(
        `seamless-fire_${country.code}_${areaSlug(state.area)}_${monthStr(first + fromIdx)}_${monthStr(first + toIdx)}_monthly.csv`,
        monthlyCsv(h, d.model, fromIdx, toIdx),
      );
    });
    dlHotspots.addEventListener('click', startHotspotExport);
    dlCancel.addEventListener('click', () => exportJob?.abort());
    window.addEventListener('hashchange', applyHash);
    initPanels();
    initMap();
    applyHash();
  }

  init();
</script>
