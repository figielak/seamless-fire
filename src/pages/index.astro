---
import Base from '../layouts/Base.astro';
---

<Base title="Seamless Fire" app>
  <div class="app">
    <aside class="panel left" id="panel-left" aria-label="Controls">
      <div class="panel-head">
        <h1>Controls</h1>
        <button type="button" id="toggle-left" class="icon" aria-expanded="true" title="Hide controls">‹</button>
      </div>
      <div class="panel-body">
        <p class="lead">
          Fire activity since 2000 on one scale: MODIS and VIIRS hotspots harmonized, so years
          before and after 2012 compare directly.
        </p>

        <details open class="sec">
          <summary>Country and area</summary>
          <div class="row">
            <select id="country" disabled aria-label="Country"><option>Loading…</option></select>
          </div>
          <span id="status" class="status" role="status"></span>
          <fieldset class="seg">
            <legend class="sr-only">Area</legend>
            <label><input type="radio" name="mode" value="country" checked /><span id="whole-label">Whole country</span></label>
            <label><input type="radio" name="mode" value="custom" /><span>Custom area</span></label>
          </fieldset>
          <div id="custom" class="custom" hidden>
            <div class="row">
              <label for="preset">Example</label>
              <select id="preset"></select>
            </div>
            <form id="rect" class="rect" autocomplete="off">
              <span class="lbl">Rectangle (degrees)</span>
              <div class="rect-grid">
                <label>W <input name="w" inputmode="decimal" /></label>
                <label>S <input name="s" inputmode="decimal" /></label>
                <label>E <input name="e" inputmode="decimal" /></label>
                <label>N <input name="n" inputmode="decimal" /></label>
              </div>
              <button type="submit">Apply rectangle</button>
            </form>
            <p id="area-note" class="note"></p>
          </div>
          <div class="row map-tools">
            <button type="button" id="draw" class="wide">✎ Draw an area on the map</button>
            <button type="button" id="draw-finish" hidden>Finish</button>
            <button type="button" id="draw-undo" hidden>Undo point</button>
            <button type="button" id="draw-cancel" hidden>Cancel</button>
          </div>
          <p id="draw-hint" class="note"></p>
        </details>

        <details open class="sec">
          <summary>Period <button type="button" id="full-period" class="linkbtn">Full period</button></summary>
          <div class="row period">
            <label><span>From</span><select id="from-m" class="small" aria-label="From month" disabled><option>…</option></select><select id="from-y" class="small" aria-label="From year" disabled><option>…</option></select></label>
            <label><span>To</span><select id="to-m" class="small" aria-label="To month" disabled><option>…</option></select><select id="to-y" class="small" aria-label="To year" disabled><option>…</option></select></label>
          </div>
        </details>

        <details open class="sec">
          <summary>Values</summary>
          <div class="view-toggle" role="group" aria-label="Calendar values">
            <button type="button" data-view="harmonized" aria-pressed="true">Harmonized</button>
            <button type="button" data-view="raw" aria-pressed="false" title="Raw counts: MODIS before 2012, then VIIRS">Raw</button>
          </div>
          <p id="view-note" class="note"></p>
        </details>

        <details open class="sec">
          <summary>Map layer</summary>
          <fieldset class="seg">
            <legend class="sr-only">Map shows</legend>
            <label><input type="radio" name="mapmode" value="month" checked autocomplete="off" /><span>Month</span></label>
            <label><input type="radio" name="mapmode" value="period" autocomplete="off" /><span>Period</span></label>
            <label title="Where fires come back: share of years with fire in the cell, for one calendar month"><input type="radio" name="mapmode" value="recur" autocomplete="off" /><span>Recurrence</span></label>
          </fieldset>
          <div class="row month-step" id="month-step">
            <button type="button" id="map-prev" class="icon" title="Previous month">‹</button>
            <span id="map-month" class="map-month">—</span>
            <button type="button" id="map-next" class="icon" title="Next month">›</button>
          </div>
          <label class="check"><input type="checkbox" id="show-hot" checked autocomplete="off" /> Hotspot points (Month view)</label>
          <div class="sub-row"><span class="sub-lbl">Rendering</span>
          <div class="view-toggle small-toggle" role="group" aria-label="Map rendering">
            <button type="button" data-smooth="1" aria-pressed="true" title="Colours blended between cell centres">Smooth</button>
            <button type="button" data-smooth="0" aria-pressed="false" title="One square per 0.1° cell">Cells</button>
          </div></div>
          <p class="note">Tip: click a calendar month or an anomaly row to map it.</p>
        </details>

        <details class="sec">
          <summary>Download</summary>
          <button type="button" id="dl-report" class="primary-dl" title="One HTML file: summary, calendar, season, trend, unusual months and places where fire comes back. Opens in any browser; print it to PDF.">Area report (HTML)</button>
          <div class="row">
            <button type="button" id="dl-monthly">Monthly series (CSV)</button>
            <button type="button" id="dl-hotspots">Hotspots (CSV)</button>
            <button type="button" id="dl-cancel" hidden>Cancel</button>
          </div>
          <span id="dl-status" class="status" role="status"></span>
          <p class="note" id="dl-note"></p>
        </details>
      </div>
    </aside>

    <section id="now" class="panel now" aria-live="polite">
      <div class="now-head"><h2>Now</h2><p class="now-month">Loading the latest month…</p></div>
      <div class="skel" aria-hidden="true"><span></span><span></span><span></span></div>
    </section>

    <div class="map-wrap">
      <div id="map" class="map" aria-label="Map of fire cells and the selected area"></div>
    </div>

    <section class="dock" id="dock" aria-label="Charts">
      <div class="dock-tabs" role="tablist">
        <button type="button" role="tab" data-tab="calendar" aria-selected="true">Calendar</button>
        <button type="button" role="tab" data-tab="annual" aria-selected="false">Per year</button>
        <button type="button" role="tab" data-tab="season" aria-selected="false">This season</button>
        <button type="button" role="tab" data-tab="forecast" aria-selected="false">Next 7 days</button>
        <button type="button" role="tab" data-tab="anomalies" aria-selected="false">Top anomalies</button>
        <button type="button" role="tab" data-tab="about" aria-selected="false">How to read</button>
      </div>
      <div class="dock-body">
        <div class="tab" data-tab="calendar">
          <p class="def"><b>1 cell-day</b> = one ~11 km grid cell with at least one vegetation fire detection on one day.
            It measures how widespread fire activity was: <b>not hectares burned, not a number of fires</b>.</p>
          <div class="cal-head">
            <p class="unit"><span id="calendar-unit">fire cell-days per month, VIIRS S-NPP scale</span>. Click a month to map it.</p>
            <div class="view-toggle small-toggle cal-toggle" role="group" aria-label="Calendar colours">
              <button type="button" data-cal="value" aria-pressed="true" title="Colour = number of fire cell-days">Cell-days</button>
              <button type="button" data-cal="anom" aria-pressed="false" title="Colour = anomaly index: month compared with its typical level">vs typical</button>
            </div>
          </div>
          <div id="calendar" class="calendar"></div>
          <p class="note" id="calendar-note"></p>
        </div>
        <div class="tab" data-tab="annual" hidden>
          <p class="unit"><span id="annual-unit">sum of monthly cell-days, ~80% interval for estimated years</span>.</p>
          <div id="annual" class="annual"></div>
          <div id="trend" class="trend"></div>
          <p class="note" id="annual-note"></p>
        </div>
        <div class="tab" data-tab="season" hidden>
          <p class="unit">Fire cell-days since 1 January, this year against the VIIRS years (VIIRS S-NPP scale).</p>
          <div id="season" class="annual"></div>
          <p class="note" id="season-note"></p>
        </div>
        <div class="tab" data-tab="forecast" hidden>
          <div id="watch" class="watch"></div>
          <h3 class="fc-title">Whole country, next 7 days</h3>
          <p class="unit">Expected fire cell-days per day for the whole country, from the fire weather forecast, starting the day after the last fire data (VIIRS S-NPP scale).</p>
          <p id="forecast-head" class="forecast-head"></p>
          <div id="forecast" class="annual"></div>
          <p class="note" id="forecast-note"></p>
        </div>
        <div class="tab" data-tab="anomalies" hidden>
          <p class="unit">Months most above their usual level (anomaly index), in the selected period. This is not the list of the largest months: see "Highest" below the table. Click a row to map it.</p>
          <div id="anomalies"></div>
          <p class="note">
            <b>Anomaly index</b> = (cell-days + k) / (typical + k); 1 = typical. Typical = median of the same
            calendar month in the 10 years before. k is a small offset that scales with the area, so tiny
            counts do not explode; the index is therefore not a plain "times more" (10 vs typical 2 can give 3.0).
            Estimated months (before 2012) are ranked by the lower end of their ~80% interval (≥): only
            the anomaly the estimate supports. In small areas this leaves out most estimated months.
          </p>
        </div>
        <div class="tab about" data-tab="about" hidden>
          <ul>
            <li>
              <b>Cell-day</b>: a 0.1° grid cell (about 11 km) with at least one vegetation fire detection on
              a given day. Industrial heat sources (FIRMS <code>type</code> 2) are removed.
            </li>
            <li>
              <b>From February 2012</b> the values are observed VIIRS S-NPP cell-days. <b>Before</b>, they are
              estimated from MODIS with a per-country model calibrated on 2012–2025
              (hover shows the ~80% interval).
            </li>
            <li>
              <b>Custom area</b>: a cell counts when its center is inside the area. Before 2012 the area gets
              its share of the country estimate (area MODIS / country MODIS). Small areas are much less
              certain than whole countries.
            </li>
            <li>
              <b>Map</b>: each cell shows its share of the harmonized value, by the same rule, so the cells
              of an area add up to its calendar value. Estimated months spread the country value over cells
              by their MODIS cell-days. Colours use one log scale for all countries; cells below about
              0.5 cell-days fade out. <i>Smooth</i> blends colours between cell centres, <i>Cells</i> shows
              one square per 0.1° cell.
            </li>
            <li>
              <b>Recurrence</b> (map layer): where fires come back. For one calendar month, each 0.01° cell
              (about 1 km) shows the share of years with at least one VIIRS S-NPP vegetation detection,
              e.g. "8 of 15 Aprils". It uses the whole S-NPP record (Feb 2012 – Oct 2026, the Jul–Aug 2022
              outage left out), not the selected period; MODIS is not used (coarser, misses small fires).
              Cells with fire in only one year are not shown. <b>Cyan rings</b> mark year-round fire:
              fire in at least 10% of all months and in at least 9 of the 12 calendar months. Vegetation
              burning is seasonal, so these are usually industrial sites (steelworks, coke plants,
              refineries) that FIRMS did not flag as such. This shows past patterns, not a fire danger
              forecast: weather and fuel are not included.
            </li>
            <li>
              Marked months have known sensor problems: early Terra data (Jan–Oct 2000), Aqua failure
              (Aug–Sep 2020), S-NPP outage (Jul–Aug 2022). Aug–Oct 2026 are preliminary (near real-time).
            </li>
            <li>
              <b>Current month</b>: from FIRMS near real-time NOAA-20 data (through the date in the "Now" panel), scaled to S-NPP by
              the per-country factor (S-NPP near real-time data ended in early November 2026). The month is marked
              "month to date" and is not ranked against full months: the "Now" panel compares its first days with
              the same days in earlier VIIRS years (2012 on). Days without data are left out of both sides.
            </li>
            <li>
              Data: NASA FIRMS active fire products (MODIS Collection 6.1, VIIRS 375 m from S-NPP and
              NOAA-20). Base map: Sentinel-2 cloudless (EOX), OpenStreetMap. Code: Apache 2.0.
              <a href="method/">Method and validation</a>.
            </li>
          </ul>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  /* Grid layout, nothing floats over the map:
       controls | Now strip (map + charts width)
       controls | map | charts                     */
  .app {
    position: fixed;
    inset: var(--header-h) 0 0 0;
    display: grid;
    grid-template-columns: var(--left-w) minmax(0, 1fr) minmax(500px, 46%);
    grid-template-rows: auto minmax(0, 1fr);
    gap: 10px;
    padding: 10px;
    overflow: hidden;
  }
  .app:has(.left.collapsed) {
    grid-template-columns: 46px minmax(0, 1fr) minmax(500px, 46%);
  }
  .map-wrap {
    grid-row: 2;
    grid-column: 2;
    position: relative;
    min-height: 0;
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
  }
  .map {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: #0b1a2b;
  }
  .panel,
  .dock {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 8px;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
    min-width: 0;
    min-height: 0;
  }
  .left {
    grid-row: 1 / 3;
    grid-column: 1;
    display: flex;
    flex-direction: column;
    align-self: start;
    max-height: 100%;
  }
  .left.collapsed .panel-body,
  .left.collapsed h1 {
    display: none;
  }
  .left.collapsed .panel-head {
    padding: 0.45rem;
    justify-content: center;
  }
  .panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.45rem 0.6rem 0.45rem 0.9rem;
    background: #eef2f7;
    color: var(--head);
    border-bottom: 1px solid var(--line);
    border-radius: 8px 8px 0 0;
  }
  .left.collapsed .panel-head {
    border-radius: 8px;
  }
  .panel-head h1 {
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin: 0;
  }
  .panel-body {
    overflow-y: auto;
    padding: 0.3rem 0.9rem 0.8rem;
  }
  .lead {
    color: var(--text);
    font-size: 0.9rem;
    line-height: 1.45;
    margin: 0.5rem 0 0.5rem;
  }
  .sec {
    border-top: 1px solid var(--line);
    padding: 0.5rem 0 0.3rem;
  }
  .sec {
    padding: 0.65rem 0 0.55rem;
  }
  .sec summary {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    list-style: none;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    margin-bottom: 0.5rem;
    color: var(--head);
  }
  .sec summary::-webkit-details-marker {
    display: none;
  }
  .sec summary::before {
    content: '';
    width: 0.4rem;
    height: 0.4rem;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(-45deg);
    transition: transform 0.15s;
    margin-right: 0.15rem;
  }
  .sec[open] summary::before {
    transform: rotate(45deg) translate(-1px, -1px);
  }
  .sec:not([open]) summary {
    margin-bottom: 0;
  }
  .linkbtn {
    margin-left: auto;
    border: 0;
    padding: 0;
    background: none;
    color: #0b5cad;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0;
    text-transform: none;
  }
  .linkbtn:hover {
    text-decoration: underline;
  }
  .sec:not([open]) .linkbtn {
    display: none;
  }
  .seg {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    border: 1px solid var(--line);
    border-radius: 6px;
    overflow: hidden;
    padding: 0;
    margin: 0 0 0.5rem;
  }
  .seg label {
    position: relative;
    text-align: center;
    cursor: pointer;
  }
  .seg label + label {
    border-left: 1px solid var(--line);
  }
  .seg input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .seg span {
    display: block;
    padding: 0.3rem 0.4rem;
  }
  .seg label:hover span {
    background: #f3f6f9;
  }
  .seg input:checked + span {
    background: var(--head);
    color: #fff;
  }
  .seg input:focus-visible + span {
    outline: 2px solid var(--head);
    outline-offset: -3px;
  }
  .sub-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0.1rem 0 0.2rem;
  }
  .sub-lbl {
    color: var(--muted);
    font-size: 0.85rem;
  }
  .sub-row .view-toggle {
    flex: 1;
  }
  .check {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0 0 0.45rem;
    font-size: 0.92rem;
  }
  button.wide {
    width: 100%;
  }
  .primary-dl {
    width: 100%;
    margin: 0 0 0.5rem;
    font-weight: 600;
  }
  .panel-body .note:empty {
    display: none;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.7rem;
    align-items: center;
    margin: 0 0 0.5rem;
  }
  fieldset.row {
    border: 0;
    padding: 0;
  }
  .row select:not(.small) {
    width: 100%;
  }
  label[for],
  .lbl {
    font-weight: 600;
  }
  .radio {
    font-weight: 400;
  }
  .custom {
    border-left: 3px solid var(--line);
    padding-left: 0.6rem;
    margin-bottom: 0.6rem;
  }
  .rect-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.3rem 0.6rem;
    margin: 0.3rem 0 0.4rem;
  }
  .rect-grid label {
    display: flex;
    gap: 0.3rem;
    align-items: center;
  }
  .rect-grid input {
    font: inherit;
    width: 100%;
    min-width: 0;
    padding: 0.2rem 0.4rem;
    border: 1px solid var(--line);
    border-radius: 6px;
  }
  .period {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.35rem;
  }
  .period label {
    display: grid;
    grid-template-columns: 2.6rem 1fr 1fr;
    gap: 0.3rem;
    align-items: center;
    font-weight: 400;
  }
  .period select {
    width: 100%;
  }
  .view-toggle {
    display: grid;
    grid-template-columns: 1fr 1fr;
    width: 100%;
    border: 1px solid var(--line);
    border-radius: 6px;
    overflow: hidden;
  }
  .view-toggle button {
    border: 0;
    border-radius: 0;
  }
  .view-toggle button + button {
    border-left: 1px solid var(--line);
  }
  .view-toggle button[aria-pressed='true'] {
    background: var(--head);
    color: #fff;
  }
  .month-step {
    flex-wrap: nowrap;
  }
  .month-step[hidden] {
    display: none;
  }
  .small-toggle {
    font-size: 0.88rem;
  }
  .small-toggle button {
    padding: 0.15rem 0.6rem;
  }
  .map-month {
    flex: 1;
    text-align: center;
    font-weight: 600;
    font-size: 0.92rem;
  }
  .now {
    grid-row: 1;
    grid-column: 2 / 4;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.4rem;
    padding: 0.6rem 1rem;
    border-left: 4px solid var(--head);
  }
  .now > .skel {
    flex: 1;
    grid-template-columns: repeat(3, 1fr);
    max-width: 40rem;
  }
  .dock {
    grid-row: 2;
    grid-column: 3;
    display: flex;
    flex-direction: column;
  }
  .dock-tabs {
    display: flex;
    gap: 0.2rem;
    align-items: center;
    padding: 0.3rem 0.4rem 0;
    border-bottom: 1px solid var(--line);
    overflow-x: auto;
  }
  .dock-tabs [role='tab'] {
    border: 0;
    border-bottom: 3px solid transparent;
    border-radius: 0;
    background: none;
    padding: 0.3rem 0.6rem;
    white-space: nowrap;
  }
  .dock-tabs [role='tab'][aria-selected='true'] {
    border-bottom-color: var(--head);
    font-weight: 700;
  }
  .skel {
    display: grid;
    gap: 0.45rem;
    margin: 0.3rem 0 0.6rem;
  }
  .skel span {
    display: block;
    height: 0.9rem;
    border-radius: 4px;
    background: linear-gradient(90deg, #eceff3 25%, #f6f7f9 50%, #eceff3 75%);
    background-size: 200% 100%;
    animation: skel 1.4s linear infinite;
  }
  .skel span {
    height: 2rem;
  }
  @keyframes skel {
    to {
      background-position: -200% 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .skel span {
      animation: none;
    }
  }
  /* Laptop screens (1280 px wide): a compact "Now" strip and tabs, so the calendar fits. */
  @media (min-width: 1151px) and (max-width: 1440px) {
    .dock-tabs [role='tab'] {
      padding: 0.3rem 0.4rem;
      font-size: 0.88rem;
    }
    .now {
      padding: 0.4rem 0.8rem;
      gap: 0.3rem 1rem;
    }
  }
  .dock-body {
    flex: 1;
    overflow-y: auto;
    padding: 0.3rem 0.9rem 0.6rem;
  }
  .dock-body .unit {
    color: var(--muted);
    font-size: 0.85rem;
    margin: 0.2rem 0;
  }
  .dock-body .def {
    font-size: 0.8rem;
    line-height: 1.35;
    margin: 0.3rem 0 0.1rem;
    padding: 0.25rem 0.5rem;
    border-left: 3px solid var(--head);
    background: #f3f6f9;
    border-radius: 0 4px 4px 0;
  }
  .cal-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem 1rem;
    flex-wrap: wrap;
  }
  .cal-toggle {
    width: auto;
    flex: 0 0 auto;
  }
  .annual {
    width: 100%;
    height: 320px;
  }
  .about ul {
    margin: 0.4rem 0;
    padding-left: 1.2rem;
    max-width: 60rem;
  }
  .about li {
    margin: 0.3rem 0;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  /* Small laptop windows: controls stay on the left (sticky), Now, map and charts stack on the
     right in page flow, so the map is visible without scrolling past the controls. */
  @media (min-width: 861px) and (max-width: 1150px) {
    .app {
      position: static;
      grid-template-columns: var(--left-w) minmax(0, 1fr);
      grid-template-rows: auto calc(100vh - var(--header-h) - 150px) auto;
      overflow: visible;
    }
    .app:has(.left.collapsed) {
      grid-template-columns: 46px minmax(0, 1fr);
    }
    .left {
      grid-row: 1 / 4;
      position: sticky;
      top: 10px;
      max-height: calc(100vh - var(--header-h) - 20px);
